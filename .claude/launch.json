{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "unifesto-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "websites/web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "unifesto-web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "websites/web", "run", "start", "--", "-p", "3005"],
      "port": 3005
    },
    {
      "name": "unifesto-apex",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "websites/apex", "run", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
