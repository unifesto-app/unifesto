# Real client IPs (S19). Every request reaches Caddy from a Cloudflare edge, so
# without this the backend saw a few dozen edge IPs and anonymous rate limits
# were shared by everyone behind the same edge (429 storms). Trust Cloudflare's
# published ranges and read the visitor from Cf-Connecting-Ip; a request from
# any other address keeps its socket IP, so the header can't be spoofed.
# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched 2026-10-14).
# Re-check before each deploy that touches this file.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

# TLS is served from a Cloudflare Origin Certificate (mounted at
# /etc/caddy/certs). Cloudflare proxies in front of the box — set the
# Cloudflare SSL/TLS mode to "Full (strict)". No ACME/Let's Encrypt here.
#
# The origin cert must cover both `unifesto.app` and `*.unifesto.app`.

(cf_origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		# J18: only Cloudflare may connect (Authenticated Origin Pulls, global,
		# on since 31 Oct 2026). Every Cloudflare edge presents a client cert
		# signed by this CA; a direct hit on the origin IP has none and is
		# refused in the TLS handshake. Turn AOP off in Cloudflare (SSL/TLS >
		# Origin Server) only after removing this block, or every site goes down.
		# CA: https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem
		# CN=origin-pull.cloudflare.net, valid to 2029-11-01, SHA-256
		# 9A:1A:C2:B4:BE:15:F9:F2:7E:EE:20:A7:34:CB:A4:E9:89:8F:61:00:1B:3B:D7:C8:4B:69:B5:6A:3E:25:A2:B9
		client_auth {
			mode require_and_verify
			trust_pool inline {
				trust_der 
			}
		}
	}
	# Access logs: the CERT-In request record (every request to every site,
	# unsampled), kept 180 days. Written under /data (the caddy_data volume) so
	# they survive redeploys; deploy.sh's rsync --delete would wipe a
	# bind-mounted ./logs. Each JSON line has ts, request.client_ip (the real
	# visitor, from Cf-Connecting-Ip via trusted_proxies), method, host, uri,
	# proto, headers (User-Agent etc.; Authorization and Cookie redacted by
	# Caddy), status, size and duration.
	# Age is the only limit that should bite: roll_keep defaults to 10 files,
	# which silently capped history at ~1 GB, so it is raised far past what
	# 180 days needs (10000 x 100 MiB raw). Rolled files are gzipped (default),
	# roughly 10x smaller. Check usage with `du -sh /data/logs` in the caddy
	# container.
	log {
		output file /data/logs/access.log {
			roll_size 100MiB
			roll_keep 10000
			roll_keep_for 4320h
		}
	}
}

api.unifesto.app {
	import cf_origin
	# The backend runs multiple replicas (see docker-compose deploy.replicas).
	# Resolve the `backend` service name against Docker's embedded DNS
	# (127.0.0.11) on a refresh interval so Caddy sees every replica IP and
	# round-robins across them, instead of pinning to one resolved address.
	reverse_proxy {
		dynamic a {
			name backend
			port 8080
			refresh 10s
			resolvers 127.0.0.11
		}
		lb_policy round_robin

		# Hand the backend exactly one address: the real visitor resolved above.
		# Express trusts one hop (`trust proxy 1`), so req.ip = this value.
		header_up X-Forwarded-For {client_ip}

		# A failed dial (replica restarting / OOM-killed / not yet booted) is
		# retried against another replica within this window instead of being
		# surfaced to the client as a 502.
		lb_try_duration 5s
		lb_try_interval 250ms

		# Passively eject a replica for 30s after a failed request (a refused or
		# timed-out dial: restarting, OOM-killed, not yet booted). Active checks
		# (health_uri) were configured here but Caddy never runs them for
		# `dynamic` upstreams, and the replica set must stay dynamic because
		# deploy.sh rolls replicas with `--scale`, which renames containers.
		# A replica that stays up but stops answering is caught by its Docker
		# healthcheck and restarted by `autoheal` (docker-compose.yml); its
		# dials then fail and this check ejects it until it is back.
		fail_duration 30s
	}
}

apex.unifesto.app {
	import cf_origin
	reverse_proxy apex:3000 {
		# The proxy rate limiter keys on this (J17); one trusted value, not the client's chain.
		header_up X-Forwarded-For {client_ip}
	}
}

# The old operator console host (Track V3). The console lives at
# www.unifesto.app/console now; shipped 4.0.5 builds and old emails still link
# here, so this 308s forever with the query kept (mobile's ?space= switch).
# Keep the `space` DNS record. Web's own redirects finish /login, /no-access.
space.unifesto.app {
	import cf_origin
	handle /console* {
		redir https://www.unifesto.app{uri} 308
	}
	# Strips /dashboard, so {uri} is the rest: /dashboard/x?q -> /console/x?q.
	handle_path /dashboard* {
		redir https://www.unifesto.app/console{uri} 308
	}
	handle {
		redir https://www.unifesto.app/console{uri} 308
	}
}

# Both hostnames serve `web`. The app's own middleware canonicalises
# unifesto.app -> www.unifesto.app, so Caddy must NOT redirect here.
unifesto.app, www.unifesto.app {
	import cf_origin
	# Tracked short links (K5): unifesto.app/l/<code> and /l/<code>/qr go
	# straight to the backend, so the click keeps the visitor's IP, referer and
	# Cf-Ipcountry and skips the apex -> www redirect.
	handle /l/* {
		reverse_proxy {
			dynamic a {
				name backend
				port 8080
				refresh 10s
				resolvers 127.0.0.11
			}
			lb_policy round_robin
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 30s
		}
	}
	# One web container: while a deploy recreates it, hold requests and retry
	# the dial instead of answering 502 (Search Console counted those as
	# "server connectivity" failures). Next boots in ~1s; 15s covers stop+start.
	handle {
		reverse_proxy web:3000 {
			lb_try_duration 15s
			lb_try_interval 250ms
			# The visitor's IP, not Cloudflare's: one trusted value, not the client's chain.
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# White-label custom domains (track H, P3). Cloudflare for SaaS terminates the
# visitor's TLS for each verified customer hostname and forwards it here; the
# web app resolves the host to its space (middleware.ts) and 404s/redirects
# anything else. Host-less block = every other hostname on :443.
https:// {
	import cf_origin
	reverse_proxy web:3000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
