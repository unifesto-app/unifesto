+
+// Unifesto Q40: a UPI app pays (method upi, intent flow). Razorpay's page would only say "complete
+// the payment in the app", so the app shows that itself, with its own Cancel (see `cancel`).
+- (BOOL)isUpiIntentRequested:(NSDictionary *)options {
+    id method = [options objectForKey:@"method"];
+    id flow = [options objectForKey:@"_[flow]"];
+    return [method isKindOfClass:[NSString class]] && [method isEqualToString:@"upi"] &&
+           [flow isKindOfClass:[NSString class]] && [flow isEqualToString:@"intent"];
+}
+
+// Unifesto Q40: the Cancel of an invisible page, the same path as the page's own Cancel button.
+RCT_EXPORT_METHOD(cancel) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (self->razorpay != nil) {
+            [self onTapCancel:nil];
+        }
+    });
 }
 
