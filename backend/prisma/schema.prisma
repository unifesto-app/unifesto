// Unifesto Authentication & User System
// Prisma Schema - Single Source of Truth
//
// Migrations: hand-written, additive, one new unique timestamp per migration
// (check `ls prisma/migrations` first; never reuse or rename one). Known
// history quirks, applied in prod and left as they are:
//   - 20260930120000 is shared by _hidden_tickets and _hackathon_foundation.
//   - 20260929120000_unifesto_stay and 20260930120000_hackathon_foundation
//     were committed after migrations that sort later than them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum Provider {
  GOOGLE
  APPLE
  EMAIL
  PHONE

  @@map("provider")
}

enum RoleScope {
  PLATFORM
  SPACE
  EVENT

  @@map("role_scope")
}

enum RoleCode {
  ADMIN
  // RETIRED (migration 20260811140000_retire_legacy_roles): ORGANISER /
  // CO_ORGANISER were remapped to SPACE_ADMIN and VOLUNTEER to MEMBER/CREW; the
  // `roles` rows and all assignments are gone. These three enum values are kept
  // in place only because Postgres cannot drop an enum value without recreating
  // the type — they are dead, and no code, role row, or assignment references
  // them. Order is preserved to avoid enum drift.
  ORGANISER
  CO_ORGANISER
  MEMBER
  VOLUNTEER
  // Event-scoped scorer for the competitive dashboard (hack.unifesto.app).
  // Judges only ever see and write their own score cells for the events they
  // are assigned to.
  JUDGE
  // Event-scoped reviewer for the competitive dashboard. Identical to JUDGE in
  // every access rule (per-round panels, edit-until-close, curator-gated
  // reveal) EXCEPT mentors submit no numeric scores — reviews/comments only.
  MENTOR

  // --- Spaces platform re-architecture (2026-08) ---
  // Distinct codes so Role.code stays @unique and middleware can route people
  // between apex (platform) and space.unifesto.app (space/event) by code alone.
  SPACE_ADMIN // SPACE scope: runs a Space (plan/billing, members, money, creates events)
  CURATOR // EVENT scope: owns one event end-to-end
  CO_CURATOR // EVENT scope: helps run an event (no publish/cancel, no money)
  CREW // EVENT scope: on-the-ground check-in / scanning only
  EMPLOYEE // PLATFORM scope: Unifesto team member (Company section + Product board in Apex)

  @@map("role_code")
}

enum SpaceStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("space_status")
}

enum SpaceVisibility {
  PUBLIC
  PRIVATE

  @@map("space_visibility")
}

enum SpaceType {
  SUPER
  REGULAR

  @@map("space_type")
}

enum SubSpaceRequestType {
  JOIN_SUPER // target already SUPER, just assign parentSpaceId
  CONVERT_AND_JOIN // target is REGULAR, convert to SUPER then assign parentSpaceId
  CONVERT_TO_SUPER // just convert a space from REGULAR to SUPER, no sub-space assignment
  CONVERT_TO_REGULAR // convert a SUPER space back to REGULAR (only when it has no children)
  REMOVE_CHILD // detach a child (subSpace) from its parent (targetSpace)
  REMOVE_PARENT // detach this space (subSpace) from its parent (targetSpace)

  @@map("sub_space_request_type")
}

enum OrgPlan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE

  @@map("org_plan")
}

enum BillingCycle {
  MONTHLY
  ANNUAL

  @@map("billing_cycle")
}

// How an organiser is billed by the platform.
enum BillingModel {
  FREE // onboarded free — no platform fee, no subscription
  REVENUE_SHARE // platform takes a % of event sales
  SUBSCRIPTION // recurring plan fee (STARTER..ENTERPRISE)

  @@map("billing_model")
}

enum EventType {
  IN_PERSON
  ONLINE
  HYBRID

  @@map("event_type")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED

  @@map("event_status")
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  SPACE_ONLY

  @@map("event_visibility")
}

enum SupportTicketStatus {
  BOT // Assist bot chat; flips to OPEN on handoff to a human
  OPEN // needs a staff reply
  PENDING // waiting on the requester
  RESOLVED // staff considers it done
  CLOSED // archived / no further action

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

enum SupportTicketCategory {
  GENERAL
  ACCOUNT
  PAYMENTS
  EVENTS
  TICKETING
  TECHNICAL
  OTHER

  @@map("support_ticket_category")
}

// Assist case kind. Typed records (RefundRequest, SpaceRequest…) stay in
// their own tables; the case points at them via subjectType + subjectId.
enum SupportCaseKind {
  HELP
  REFUND
  CANCELLATION
  REQUEST
  REPORT
  PRIVACY
  GRIEVANCE

  @@map("support_case_kind")
}

// Which inbox works the case. SPACE = the space in `spaceId`.
enum SupportDesk {
  SPACE
  PLATFORM

  @@map("support_desk")
}

enum SupportMessageSide {
  REQUESTER
  DESK
  ASSISTANT // Assist bot
  SYSTEM // posted by an action (refund approved, request accepted…)

  @@map("support_message_side")
}

enum RegistrationType {
  RSVP
  TICKETED
  MIXED

  @@map("registration_type")
}

enum TicketKind {
  RSVP // one-click, free registration
  INDIVIDUAL // single attendee, free or paid
  GROUP // multiple attendees under one registration

  @@map("ticket_kind")
}

enum GroupPricingMode {
  PER_GROUP // one flat price for the whole group
  PER_PERSON // price multiplied by the number of people in the group

  @@map("group_pricing_mode")
}

enum CouponDiscountType {
  PERCENT // discountValue is a percentage (0-100) off the base ticket amount
  FLAT // discountValue is a flat amount (in the ticket currency) off the base

  @@map("coupon_discount_type")
}

/// Lifecycle of a single coupon application against one registration.
///   RESERVED  = slot held while the buyer completes payment (counts toward the
///               coupon's usage cap). Released if the payment is abandoned,
///               fails, or the reservation TTL lapses.
///   CONFIRMED = payment settled; the redemption is permanent.
enum CouponRedemptionStatus {
  RESERVED
  CONFIRMED

  @@map("coupon_redemption_status")
}

enum FormFieldType {
  TEXT
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
  NUMBER
  EMAIL
  PHONE
  DATE
  URL
  YES_NO
  FILE
  SECTION
  STATE
  RATING

  @@map("form_field_type")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  PENDING_CURATOR
  PENDING_ADMIN
  /// Claimed by an admin approval while Razorpay is called. A row stuck here
  /// (10+ min) can be approved again: refunds are keyed, so it never pays twice.
  PROCESSING
  APPROVED
  REJECTED
  /// Razorpay accepted then failed the refund (refund.failed): nothing went
  /// back. Still owed, held out of payouts, and approvable again to re-send.
  REFUND_FAILED

  @@map("refund_status")
}

/// How an approved refund's cash portion is returned. Refunds are always issued
/// as a Razorpay charge-back to the original payment method (5–7 days).
enum RefundMethod {
  BANK

  @@map("refund_method")
}

enum RefundRequesterRole {
  ATTENDEE
  CURATOR
  ADMIN

  @@map("refund_requester_role")
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW

  @@map("registration_status")
}

/// Lifecycle of a waiting-list entry. Set only on registrations that entered
/// via the waiting list; null on registrations that bought a seat directly.
enum WaitlistStatus {
  WAITING // queued, no seat held
  OFFERED // organiser allowed them in; seat held until offerExpiresAt
  CONVERTED // paid (or free) and now holds a real seat
  EXPIRED // offer lapsed unpaid; seat released back to the pool
  DECLINED // attendee turned the offer down; seat released

  @@map("waitlist_status")
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED

  @@map("ticket_status")
}

/// Who a batch of certificates is issued to. Chosen per issuance, so a single
/// event can hand a "participation" certificate to everyone who attended and a
/// separate "winner" certificate to a hand-picked few.
enum CertificateAudience {
  /// Everyone with a check-in record / checkedInAt for the event.
  CHECKED_IN
  /// Every confirmed, non-waitlisted registrant, attendance aside.
  CONFIRMED
  /// A hand-picked list of registrations the organiser selects.
  MANUAL

  @@map("certificate_audience")
}

/// Lifecycle of an issued certificate. REVOKED certificates still resolve on
/// the public verify page (so a shared link doesn't 404) but report as invalid.
enum CertificateStatus {
  ISSUED
  REVOKED

  @@map("certificate_status")
}

/// Lifecycle of a queued certificate-issuance batch.
enum CertificateBatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("certificate_batch_status")
}

/// How an event report was configured. DEFAULT bundles every section; CUSTOM
/// carries the organiser-chosen subset. The type is stored (not just the
/// section list) so the history can label a report at a glance.
enum ReportType {
  DEFAULT
  CUSTOM

  @@map("report_type")
}

/// Generation lifecycle of an event report. PENDING is the brief window between
/// the row being created and the PDF being rendered + uploaded; READY once the
/// file exists; FAILED (with `error`) when rendering threw.
enum ReportStatus {
  PENDING
  READY
  FAILED

  @@map("report_status")
}

/// The sections a report can contain. A DEFAULT report includes all of them; a
/// CUSTOM report includes the subset the organiser picked. Persisted per report
/// so a re-download always reflects the sections the file was built with.
enum ReportSection {
  /// Event details + headline KPIs (registrations, attendance, revenue).
  OVERVIEW
  /// Per ticket-type breakdown: sold, revenue, seats remaining.
  TICKETS
  /// Attendee roster: name, email, ticket, status, checked-in.
  ATTENDEES
  /// Money in/out: collected, fees, refunds, net.
  REVENUE
  /// Check-in / attendance summary.
  CHECKINS

  @@map("report_section")
}

// =====================================================
// USER MODEL
// Core user entity - one person = one account
// =====================================================

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Identity (Canonical)
  mobileNumber   String  @unique @map("mobile_number") @db.VarChar(20)
  mobileVerified Boolean @default(false) @map("mobile_verified")

  // Profile
  username  String? @unique @db.VarChar(50)
  fullName  String? @map("full_name") @db.VarChar(255)
  avatarUrl String? @map("avatar_url") @db.Text
  bio       String? @db.Text
  gender    String? @db.VarChar(30)

  // Social Links
  linkedinUrl  String? @map("linkedin_url") @db.Text
  instagramUrl String? @map("instagram_url") @db.Text
  githubUrl    String? @map("github_url") @db.Text
  websiteUrl   String? @map("website_url") @db.Text

  // App client (self-reported by the mobile app on session start)
  appVersion               String?   @map("app_version") @db.VarChar(20)
  appPlatform              String?   @map("app_platform") @db.VarChar(10)
  appVersionLastReportedAt DateTime? @map("app_version_last_reported_at") @db.Timestamptz(6)
  // EAS Update runtime (fingerprint) + running OTA update id (null = the store build's own code).
  // 4.0.x clients never report these. Feeds the adoption view in Apex › OTA updates.
  appRuntimeVersion        String?   @map("app_runtime_version") @db.VarChar(64)
  appUpdateId              String?   @map("app_update_id") @db.VarChar(36)

  // Last authenticated request from any client (mobile, web, space, apex).
  // Stamped by JwtAuthGuard, throttled to one write per user per 5 minutes.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  // Every access/refresh token carries the value it was issued under (`tv`);
  // bumping it revokes all of the user's sessions (logout-all, refresh theft).
  tokenVersion Int @default(0) @map("token_version")

  // Account deletion is a request with a 30-day grace period. The user can
  // cancel any time before it's due; after that a daily job closes the account.
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  // Set when the account is actually closed. PII is scrubbed and sign-ins
  // removed, but the row stays so paid registrations, refunds and payouts keep
  // their foreign keys. Auth rejects any user with this set.
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  identities                   UserIdentity[]
  spaceRequests                SpaceRequest[]
  eventRequests                EventRequest[]
  roles                        UserRole[]                    @relation("UserRoles")
  assignedRoles                UserRole[]                    @relation("AssignedBy")
  createdSpaces                Space[]                       @relation("SpaceCreator")
  createdEvents                Event[]                       @relation("EventCreator")
  contentReports               ContentReport[]               @relation("ContentReporter")
  registrations                EventRegistration[]
  emailCampaignsSent           EmailCampaign[]               @relation("EmailCampaignsSent")
  emailTemplatesCreated        EmailTemplate[]               @relation("EmailTemplatesCreated")
  adminDevices                 AdminDevice[]
  pushDevices                  UserPushDevice[]
  bankAccounts                 PayoutBankAccount[]
  payoutsReceived              Payout[]                      @relation("PayoutUser")
  refundRequests               RefundRequest[]               @relation("RefundRequestedBy")
  spaceStatusRequests          SpaceStatusRequest[]          @relation("SpaceStatusRequestUser")
  subSpaceRequests             SubSpaceRequest[]             @relation("SubSpaceRequestUser")
  ownershipRequestsMade        SpaceOwnershipRequest[]       @relation("SpaceOwnershipRequester")
  ownershipRequestsReceived    SpaceOwnershipRequest[]       @relation("SpaceOwnershipNewOwner")
  whiteLabelRequests           WhiteLabelRequest[]           @relation("WhiteLabelRequester")
  freeAttendeeAddRequests      FreeAttendeeAddRequest[]      @relation("FreeAttendeeAddRequester")
  registrationTransferRequests RegistrationTransferRequest[] @relation("RegTransferRequester")
  eventTransferRequests        EventOwnershipTransfer[]      @relation("EventTransferRequester")
  subEventAttachRequests       SubEventAttachRequest[]       @relation("SubEventAttachRequester")
  notificationSettings         NotificationSettings?
  inAppNotifications           UserNotification[]
  supportTicketsRaised         SupportTicket[]               @relation("SupportTicketRequester")
  supportTicketsAssigned       SupportTicket[]               @relation("SupportTicketAssignee")
  supportMessages              SupportMessage[]              @relation("SupportMessageAuthor")
  checkinAccess                EventCheckinAccess[]          @relation("CheckinAccessUser")
  checkinRecordsCreated        EventCheckinRecord[]          @relation("CheckedInBy")
  groupMemberCheckinsCreated   EventGroupMemberCheckin[]     @relation("GroupMemberCheckedInBy")
  claimedGroupSeats            GroupSeat[]                   @relation("GroupSeatClaimedBy")
  leadTransfersFrom            GroupLeadTransfer[]           @relation("LeadTransferFrom")
  leadTransfersTo              GroupLeadTransfer[]           @relation("LeadTransferTo")
  groupSeatPurchases           GroupSeatPurchase[]
  hiddenTickets                HiddenTicket[]
  registrationsCheckedIn       EventRegistration[]           @relation("RegistrationCheckedInBy")
  favorites                    FavoriteEvent[]
  createdSessions              Session[]                     @relation("SessionCreator")
  sessionRegistrations         SessionRegistration[]
  sessionCoHosts               SessionCoHost[]
  certificatesReceived         Certificate[]                 @relation("CertificateRecipient")
  // Sponsor portal: the sponsor entities this account may act on behalf of.
  sponsorMemberships           SponsorUser[]                 @relation("SponsorUserAccount")
  couponRedemptions            CouponRedemption[]
  questions                    Question[]
  questionVotes                QuestionVote[]
  partnerLinks                 EventPartnerLink[]            @relation("PartnerLinkContact")
  stayBookings                 StayBooking[]                 @relation("StayBooker")
  pollVotes                    PollVote[]
  quizAnswers                  QuizAnswer[]
  legalAcceptances             LegalAcceptance[]
  orbitLeads                   OrbitLead[]
  orbitApplications            OrbitApplication[]

  @@index([deletionRequestedAt])
  @@map("users")
}

// =====================================================
// NOTIFICATION SETTINGS MODEL
// Per-user notification preferences
// =====================================================

model NotificationSettings {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // User Reference (one-to-one)
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Preferences
  pushEnabled     Boolean @default(true) @map("push_enabled")
  emailEnabled    Boolean @default(true) @map("email_enabled")
  eventReminders  Boolean @default(true) @map("event_reminders")
  newEvents       Boolean @default(true) @map("new_events")
  promotions      Boolean @default(false) @map("promotions")

  // Registration/space category switches
  registrationUpdates Boolean @default(true) @map("registration_updates")
  spaceUpdates        Boolean @default(true) @map("space_updates")

  // Organiser-to-attendee announcements (added by notifications platform)
  organiserAnnouncements Boolean @default(true) @map("organiser_announcements")

  // Admin product/app announcements (opt-OUT: on by default, unlike promotions).
  productUpdates Boolean @default(true) @map("product_updates")

  // Email switches for the categories that send OPTIONAL mail (C4). Every
  // other category's mail is transactional (always sent) or doesn't exist.
  // emailEnabled stays the master switch over these.
  emailEventReminders Boolean @default(true) @map("email_event_reminders")
  emailNewEvents      Boolean @default(true) @map("email_new_events")

  // Quiet hours (C4): minutes after midnight IST (0-1439). Both set and
  // different = on; a window may cross midnight. Non-critical pushes inside
  // it are scheduled for the window's end.
  quietHoursStart Int? @map("quiet_hours_start") @db.SmallInt
  quietHoursEnd   Int? @map("quiet_hours_end") @db.SmallInt

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_settings")
}

enum MarketingChannel {
  EMAIL
  WHATSAPP

  @@map("marketing_channel")
}

/// "Stop sending me marketing." Keyed by `address`: a lowercased email for
/// EMAIL, an E.164 number (+919876543210) for WHATSAPP. `spaceId` null = all
/// marketing on that channel; set = only that space's campaigns. `userId` is
/// filled when the address matched an account, so the opt-out follows the
/// person if their address changes. Plain uuids, no FKs: a suppression must
/// outlive the account or space. Read by email campaigns (+ the audience count)
/// and the WhatsApp blast; transactional mail never reads it.
model MarketingOptOut {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  channel MarketingChannel
  address String           @db.VarChar(255)
  userId  String?          @map("user_id") @db.Uuid
  spaceId String?          @map("space_id") @db.Uuid
  // link (unsubscribe page) | one_click (List-Unsubscribe-Post) | whatsapp_stop
  source  String           @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([channel, spaceId])
  @@index([address])
  @@index([userId])
  @@map("marketing_opt_outs")
}

/// The in-app copy of a notification, kept whether or not the push was sent
/// (push can be off; the in-app feed still shows it). Written by
/// NotificationsService.send when the caller passes `inbox`.
model UserNotification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The event it's about, so an event's screens can show just their own feed.
  eventId  String?   @map("event_id") @db.Uuid
  // What produced it, e.g. "hackathon". Lets the app filter and pick an icon.
  type     String    @db.VarChar(40)
  title    String    @db.VarChar(200)
  body     String    @db.Text
  deepLink String?   @map("deep_link") @db.Text
  data     Json?
  readAt   DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, eventId, readAt])
  @@index([createdAt]) // retention sweep (RetentionService)
  @@map("user_notifications")
}

// =====================================================
// USER IDENTITY MODEL
// Authentication methods linked to a single user
// =====================================================

model UserIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // User Reference
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Provider Information
  provider       Provider
  providerUserId String   @map("provider_user_id") @db.Text

  // Email (may be null for phone provider)
  email         String?  @db.VarChar(255)
  emailVerified Boolean? @default(false) @map("email_verified")
  isPrimary     Boolean  @default(false) @map("is_primary")

  // APPLE only (O17): refresh token from the sign-in code exchange, AES-256-GCM
  // encrypted, revoked at Apple when the account is deleted. Null for Apple
  // sign-ins from before it was stored.
  appleRefreshToken String? @map("apple_refresh_token") @db.Text

  // Metadata
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Constraints
  @@unique([provider, providerUserId], name: "unique_provider_user")
  @@unique([provider, email], name: "unique_provider_email")
  @@index([userId])
  @@index([provider])
  @@index([email])
  @@map("user_identities")
}

// =====================================================
// ROLE MODEL
// Simple role definitions
// =====================================================

model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code  RoleCode  @unique
  name  String    @db.VarChar(100)
  scope RoleScope

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

/// One editable capability grant: a single (role, action) pair that the role
/// may perform DIRECTLY at its own scope. This is the DB-backed form of the
/// compiled `CAPABILITIES` matrix (backend/src/auth/authorization/capabilities.ts),
/// mirroring how `PlanConfig` made plan feature flags editable. Seeded from that
/// matrix; edited by Platform Admin via the Apex IAM console.
///
/// Deliberately NOT keyed to the `Role` table by FK: rows are addressed by
/// `RoleCode` so a grant survives even if a Role row is reseeded, and so the
/// in-memory authorization cache never needs a join. `action` holds an `Action`
/// value (e.g. "space:manage-billing") as text — the catalogue is a code enum,
/// not a DB enum, so new actions ship without a schema change.
///
/// ADMIN never appears here: platform-admin power is an inheritance rule in
/// AuthorizationService, not a matrix row, so no edit in this table can ever
/// strip the platform superuser of access.
model RoleCapability {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code   RoleCode @map("role_code")
  action String   @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([code, action])
  @@index([code])
  @@map("role_capabilities")
}

/// Per-space override of the capability matrix ("IAM for Spaces"). A Space Admin
/// can tune what their event roles (Curator / Co-Curator / Crew) may do WITHIN
/// their space, on top of the platform-global `RoleCapability` defaults.
///
/// Resolution mirrors the global fallback: if a (space, role) pair has ANY rows
/// here, that set is authoritative for that role in that space; if it has none,
/// the role inherits the global matrix. So a row's presence means "this space
/// fully defines this role" — customising a role materialises its whole current
/// action set, then edits from there.
///
/// Out of scope by policy (enforced in CapabilityConfigService, not the schema):
/// SPACE_ADMIN is never overridable (a space can't lock its own admin out), and
/// `event:manage-money` stays platform-controlled (separation of duty).
model SpaceRoleCapability {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId String   @map("space_id") @db.Uuid
  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  code    RoleCode @map("role_code")
  action  String   @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([spaceId, code, action])
  @@index([spaceId])
  @@map("space_role_capabilities")
}

// =====================================================
// USER ROLE MODEL
// Role assignments to users
// =====================================================

model SpaceRequest {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String          @db.VarChar(255)
  description String?         @db.Text
  type        SpaceType       @default(REGULAR)
  visibility  SpaceVisibility @default(PUBLIC)
  city        String?         @db.VarChar(100)
  state       String?         @db.VarChar(100)
  country     String?         @default("India") @db.VarChar(100)
  tags        String[]
  websiteUrl  String?         @map("website_url") @db.Text
  // The requester's role at the organisation (e.g. "President, Coding Club")
  // and when they declared they are authorised to represent it and to use its
  // name and logo. Null declaration = an older client that never asked.
  requesterRole        String?   @map("requester_role") @db.VarChar(120)
  authorityConfirmedAt DateTime? @map("authority_confirmed_at") @db.Timestamptz(6)
  status      String          @default("PENDING") @db.VarChar(20)
  reviewNote  String?         @map("review_note") @db.Text
  reviewedBy  String?         @map("reviewed_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("space_requests")
}

/// Host one event without a Space (Assist D7). Platform approves: that
/// creates a personal Space run by the requester and the event as a DRAFT.
model EventRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String    @db.VarChar(500)
  description   String?   @db.Text
  type          EventType @default(IN_PERSON)
  startDateTime DateTime  @map("start_date_time") @db.Timestamptz(6)
  endDateTime   DateTime  @map("end_date_time") @db.Timestamptz(6)
  city          String?   @db.VarChar(100)
  status        String    @default("PENDING") @db.VarChar(20)
  reviewNote    String?   @map("review_note") @db.Text
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  /// Set on approval: the personal space and the draft event it made.
  spaceId       String?   @map("space_id") @db.Uuid
  eventId       String?   @map("event_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("event_requests")
}

model SpaceStatusRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId         String    @map("space_id") @db.Uuid
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  requestedBy     String    @map("requested_by") @db.Uuid
  user            User      @relation("SpaceStatusRequestUser", fields: [requestedBy], references: [id])
  currentStatus   String    @map("current_status") @db.VarChar(20)
  requestedStatus String    @map("requested_status") @db.VarChar(20)
  reason          String    @db.Text
  status          String    @default("PENDING") @db.VarChar(20)
  reviewNote      String?   @map("review_note") @db.Text
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@index([requestedBy])
  @@index([status])
  @@map("space_status_requests")
}

/// A space creator asking to hand ownership to another member, subject to
/// admin approval.
///
/// Ownership is `Space.createdBy`, which the member-role editor deliberately
/// refuses to touch (the creator must remain Organiser). Transferring it is
/// therefore not a role change but its own reviewed action: it moves the
/// space's billing subject and its last-resort administrator, so it goes
/// through an admin the same way status and sub-space changes do.
model SpaceOwnershipRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// The current creator giving ownership up.
  requestedBy String @map("requested_by") @db.Uuid
  requester   User   @relation("SpaceOwnershipRequester", fields: [requestedBy], references: [id])

  /// The member being handed the space. Must already belong to it when the
  /// request is made *and* when it is approved.
  newOwnerId String @map("new_owner_id") @db.Uuid
  newOwner   User   @relation("SpaceOwnershipNewOwner", fields: [newOwnerId], references: [id])

  reason     String    @db.Text
  status     String    @default("PENDING") @db.VarChar(20)
  reviewNote String?   @map("review_note") @db.Text
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@index([requestedBy])
  @@index([newOwnerId])
  @@index([status])
  @@map("space_ownership_requests")
}

/// An organiser's request to white-label a space or one of its events with
/// their own logo + accent colour. Reviewed by an admin, exactly like status
/// and ownership requests. `eventId` is null for a space-level request and set
/// for an event-level one. On approval the proposed branding is copied onto the
/// target Space/Event and its `whiteLabelEnabled` flag is flipped on. Rendering
/// additionally requires the space's plan to include `hasRemoveBranding`, so a
/// later downgrade silently disables branding without touching this row.
enum DomainKind {
  WEB
  EMAIL
}

/// A domain a space owns and has pointed at us, for white-label. EMAIL =
/// sending domain verified with Resend (DKIM/SPF); WEB = custom hostname for
/// the public pages. One per kind per space. Used only once `status` is
/// 'verified' and the space's branding is live.
model SpaceDomain {
  id      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId String     @map("space_id") @db.Uuid
  space   Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind    DomainKind
  /// Lower-case FQDN, e.g. `mail.acme.edu`.
  hostname String @unique @db.VarChar(253)
  /// EMAIL only: the mailbox part of the From address (`tickets`@hostname).
  emailLocalPart String? @map("email_local_part") @db.VarChar(64)
  /// Provider's id (Resend domain id / Cloudflare custom hostname id).
  providerId String? @map("provider_id") @db.VarChar(100)
  /// Provider status as reported: pending | verified | failed | ...
  status  String @default("pending") @db.VarChar(30)
  /// DNS records the space must add, as the provider returned them.
  records Json   @default("[]")
  /// WEB only: our ownership TXT token (`_unifesto.<hostname>` = `unifesto-verify=<token>`).
  /// Null only on domains verified before H25.
  verifyToken String? @map("verify_token") @db.VarChar(64)
  /// First time it verified; kept if it later lapses (only never-verified claims expire).
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([spaceId, kind])
  @@map("space_domains")
}

model WhiteLabelRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// Null = space-level request; set = event-level request.
  eventId String? @map("event_id") @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  requestedBy String @map("requested_by") @db.Uuid
  requester   User   @relation("WhiteLabelRequester", fields: [requestedBy], references: [id])

  /// Proposed branding to apply on approval.
  brandColor   String? @map("brand_color") @db.VarChar(9)
  brandLogoUrl String? @map("brand_logo_url") @db.Text

  reason     String    @db.Text
  status     String    @default("PENDING") @db.VarChar(20)
  reviewNote String?   @map("review_note") @db.Text
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@index([eventId])
  @@index([requestedBy])
  @@index([status])
  @@map("white_label_requests")
}

/// An organiser's request to be allowed to add attendees FOR FREE on one event
/// (i.e. comp a paid ticket instead of sending a payment link). Blocked by
/// default so the platform fee is never silently waived; a Platform Admin
/// approves or rejects. An approval is a seat quota (A27): `approvedSeats` paid
/// seats, on one ticket type or any (`ticketTypeId` null), drawn down by every
/// comp (single add, CSV import, curator add-seats) and revocable. Legacy
/// approvals from before A27 have `approvedSeats` null = unlimited until revoked.
model FreeAttendeeAddRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  requestedBy String @map("requested_by") @db.Uuid
  requester   User   @relation("FreeAttendeeAddRequester", fields: [requestedBy], references: [id])

  /// Scope: one paid ticket type, or null = any ticket type on the event.
  ticketTypeId String?          @map("ticket_type_id") @db.Uuid
  ticketType   EventTicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  /// Seats the organiser asked for; the admin approves `approvedSeats`.
  requestedSeats Int? @map("requested_seats")
  approvedSeats  Int? @map("approved_seats")
  /// Seats already comped against this approval (atomic, never above approved).
  usedSeats      Int  @default(0) @map("used_seats")

  reason     String    @db.Text
  /// PENDING, APPROVED, REJECTED, or REVOKED (an approval withdrawn).
  status     String    @default("PENDING") @db.VarChar(20)
  reviewNote String?   @map("review_note") @db.Text
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@index([eventId])
  @@index([requestedBy])
  @@index([status])
  @@index([eventId, status])
  @@map("free_attendee_add_requests")
}

/// An organiser's request to hand a registration to a different account.
/// Organisers cannot transfer tickets themselves — they raise a request that an
/// admin approves (which performs the transfer) or rejects. Admins can also
/// transfer directly without a request. `targetEmail` is the account to receive
/// the ticket; it is resolved to a user only at approval time.
/// At most one PENDING request per registration (partial unique index
/// registration_transfer_requests_one_pending in the migration).
model RegistrationTransferRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  registrationId String            @map("registration_id") @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  requestedBy String @map("requested_by") @db.Uuid
  requester   User   @relation("RegTransferRequester", fields: [requestedBy], references: [id])

  targetEmail String  @map("target_email") @db.VarChar(255)
  reason      String? @db.Text

  status     String    @default("PENDING") @db.VarChar(20)
  reviewNote String?   @map("review_note") @db.Text
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([registrationId])
  @@index([requestedBy])
  @@index([status])
  @@map("registration_transfer_requests")
}

model UserRole {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // User Reference
  userId String @map("user_id") @db.Uuid
  user   User   @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  // Role Reference
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Space context (null for platform roles)
  spaceId String? @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Event context (set for event-scoped roles, e.g. VOLUNTEER)
  eventId String? @map("event_id") @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Audit
  assignedBy     String? @map("assigned_by") @db.Uuid
  assignedByUser User?   @relation("AssignedBy", fields: [assignedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Constraints
  @@unique([userId, roleId, spaceId, eventId], name: "unique_user_role_scope")
  @@index([userId])
  @@index([roleId])
  @@index([spaceId])
  @@index([eventId])
  @@map("user_roles")
}

// =====================================================
// SPACE MODEL
// Community spaces (formerly organizations)
// =====================================================

model Space {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Basic Information
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(100) // Like username, e.g., @tech-community
  description String? @db.Text
  websiteUrl  String? @map("website_url") @db.Text

  // Images
  logoUrl   String? @map("logo_url") @db.Text
  bannerUrl String? @map("banner_url") @db.Text

  // White-label branding (attendee-facing). Self-serve: a curator switches
  // `whiteLabelEnabled` on in the Branding studio. It renders ONLY while the
  // space's plan includes `hasRemoveBranding` AND a platform admin hasn't set
  // `brandingSuspendedAt` (see resolveSpaceBranding).
  whiteLabelEnabled   Boolean   @default(false) @map("white_label_enabled")
  brandingSuspendedAt DateTime? @map("branding_suspended_at") @db.Timestamptz(6)
  brandColor          String?   @map("brand_color") @db.VarChar(9)
  // Wide wordmark for the branded header; falls back to the square `logoUrl`.
  brandLogoUrl        String?   @map("brand_logo_url") @db.Text
  // Preset key (see BRAND_FONTS in branding.util), null = Unifesto's font.
  brandFont           String?   @map("brand_font") @db.VarChar(40)
  // 'light' | 'dark' forces the page theme; null = the visitor's choice.
  brandMode           String?   @map("brand_mode") @db.VarChar(10)
  // Drops the "Powered by Unifesto" line from branded pages and emails.
  hidePoweredBy       Boolean   @default(false) @map("hide_powered_by")
  //   faviconUrl    — the tab icon on public space/event pages.
  //   emailFromName — display name on attendee emails.
  //   emailReplyTo  — Reply-To on those emails, so replies reach the organiser.
  faviconUrl          String?   @map("favicon_url") @db.Text
  emailFromName       String?   @map("email_from_name") @db.VarChar(100)
  emailReplyTo        String?   @map("email_reply_to") @db.VarChar(255)

  // Location
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  country String? @db.VarChar(100)

  // Configuration
  tags       String[] // Array of tags
  visibility SpaceVisibility @default(PUBLIC)

  // Type & Hierarchy
  type                 SpaceType @default(REGULAR) @map("type")
  parentSpaceId        String?   @map("parent_space_id") @db.Uuid
  parentSpace          Space?    @relation("SpaceHierarchy", fields: [parentSpaceId], references: [id])
  childSpaces          Space[]   @relation("SpaceHierarchy")
  parentRequestPending Boolean   @default(false) @map("parent_request_pending")
  requestedParentId    String?   @map("requested_parent_id") @db.Uuid

  // Plan
  plan            OrgPlan   @default(STARTER)
  planActivatedAt DateTime? @map("plan_activated_at") @db.Timestamptz(6)
  planExpiresAt   DateTime? @map("plan_expires_at") @db.Timestamptz(6)

  // Limits
  coCuratorLimit Int @default(5) @map("co_organiser_limit") // Set by admin

  // Status & Workflow
  status          SpaceStatus @default(PENDING)
  submittedAt     DateTime?   @map("submitted_at") @db.Timestamptz(6)
  approvedAt      DateTime?   @map("approved_at") @db.Timestamptz(6)
  rejectedAt      DateTime?   @map("rejected_at") @db.Timestamptz(6)
  approvedBy      String?     @map("approved_by") @db.Uuid
  rejectionReason String?     @map("rejection_reason") @db.Text

  // Verified = a platform admin confirmed this space is run by (or with the
  // permission of) the organisation it is named after. Unverified spaces show
  // a "not affiliated" note publicly. Cleared when the space is renamed.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy String?   @map("verified_by") @db.Uuid

  // Creator
  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("SpaceCreator", fields: [createdBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  userRoles                UserRole[]
  events                   Event[]
  orbitLeads               OrbitLead[]
  orbitApplications        OrbitApplication[]
  statusRequests           SpaceStatusRequest[]
  ownershipRequests        SpaceOwnershipRequest[]
  whiteLabelRequests       WhiteLabelRequest[]
  domains                  SpaceDomain[]
  freeAttendeeAddRequests  FreeAttendeeAddRequest[]
  subSpaceRequests         SubSpaceRequest[]        @relation("SubSpaceRequests")
  targetSpaceRequests      SubSpaceRequest[]        @relation("TargetSpaceRequests")
  supportTickets           SupportTicket[]
  cannedReplies            CannedReply[]
  coHostedEvents           EventCoHost[]
  eventTransfersFrom       EventOwnershipTransfer[] @relation("EventTransferFromSpace")
  eventTransfersTo         EventOwnershipTransfer[] @relation("EventTransferToSpace")
  subEventAttachRequesting SubEventAttachRequest[]  @relation("SubEventAttachRequestingSpace")
  subEventAttachOwning     SubEventAttachRequest[]  @relation("SubEventAttachOwnerSpace")
  sessions                 Session[]
  // Per-space billing (P0.2). One plan per Space.
  subscription             OrgSubscription?
  // Per-space capability overrides (IAM for Spaces).
  roleCapabilities         SpaceRoleCapability[]
  // Outbound email (campaigns + saved templates) owned by this space.
  emailCampaigns           EmailCampaign[]          @relation("SpaceEmailCampaigns")
  emailTemplates           EmailTemplate[]          @relation("SpaceEmailTemplates")
  // Sponsors & lead generation: the reusable sponsor roster, the tier ladder
  // sponsors are ranked in, and the organiser's own lead funnel.
  sponsors                 Sponsor[]
  sponsorTiers             SponsorTier[]
  leads                    Lead[]
  // Traffic: views of the space page and its events, and its short links.
  pageViews                PageView[]
  shortLinks               ShortLink[]

  @@index([slug])
  @@index([status])
  @@index([createdBy])
  @@index([type])
  @@index([parentSpaceId])
  @@map("spaces")
}

model SubSpaceRequest {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType SubSpaceRequestType @map("request_type")

  // The space being made a sub-space (null for CONVERT_TO_SUPER)
  subSpaceId String? @map("sub_space_id") @db.Uuid
  subSpace   Space?  @relation("SubSpaceRequests", fields: [subSpaceId], references: [id], onDelete: Cascade)

  // The target parent space
  targetSpaceId String @map("target_space_id") @db.Uuid
  targetSpace   Space  @relation("TargetSpaceRequests", fields: [targetSpaceId], references: [id], onDelete: Cascade)

  requestedBy String @map("requested_by") @db.Uuid
  user        User   @relation("SubSpaceRequestUser", fields: [requestedBy], references: [id])

  reason     String    @db.Text
  status     String    @default("PENDING") @db.VarChar(20)
  reviewNote String?   @map("review_note") @db.Text
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([subSpaceId])
  @@index([targetSpaceId])
  @@index([requestedBy])
  @@index([status])
  @@map("sub_space_requests")
}

// =====================================================
// SUBSCRIPTION MODEL
// Organization subscription plans
// =====================================================

model OrgSubscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Spaces platform re-architecture: the billing subject is the Space. Every
  // subscription is keyed by `spaceId`. The P2.2 contract migration dropped the
  // legacy per-user `userId` column.
  spaceId String? @unique @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // How this organiser is billed by the platform.
  billingModel        BillingModel @default(SUBSCRIPTION) @map("billing_model")
  // For REVENUE_SHARE: platform's cut of event sales, e.g. 8.00 (%).
  revenueSharePercent Decimal?     @map("revenue_share_percent") @db.Decimal(5, 2)

  plan         OrgPlan      @default(STARTER)
  billingCycle BillingCycle @default(MONTHLY) @map("billing_cycle")
  amount       Decimal      @default(0) @db.Decimal(10, 2)
  currency     String       @default("INR") @db.VarChar(3)
  isActive     Boolean      @default(true) @map("is_active")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  razorpaySubId String?   @map("razorpay_sub_id") @db.VarChar(255)
  lastPaymentAt DateTime? @map("last_payment_at") @db.Timestamptz(6)
  nextPaymentAt DateTime? @map("next_payment_at") @db.Timestamptz(6)

  eventsThisMonth Int      @default(0) @map("events_this_month")
  usageResetAt    DateTime @default(now()) @map("usage_reset_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  history SubscriptionHistory[]

  @@map("org_subscriptions")
}

model SubscriptionHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  subscriptionId String          @map("subscription_id") @db.Uuid
  subscription   OrgSubscription @relation(fields: [subscriptionId], references: [id])

  fromPlan  OrgPlan  @map("from_plan")
  toPlan    OrgPlan  @map("to_plan")
  reason    String?  @db.VarChar(500)
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  // Razorpay payment that paid for this change; unique so one receipt upgrades once.
  paymentId String?  @unique @map("payment_id") @db.VarChar(255)

  @@map("subscription_history")
}

/// Provider webhook deliveries already processed (Razorpay `x-razorpay-event-id`),
/// so a retried delivery is acknowledged without re-running its side effects.
model WebhookEvent {
  id         String   @id @db.VarChar(255)
  source     String   @db.VarChar(32)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

// Admin-editable definition of what each subscription plan includes.
// One row per OrgPlan. Null numeric = unlimited. Drives both display and
// enforcement (via the cached PlanConfigService).
model PlanConfig {
  plan OrgPlan @id

  // Limits (null = unlimited)
  spaces            Int?
  eventsPerMonth    Int? @map("events_per_month")
  attendeesPerEvent Int? @map("attendees_per_event")
  ticketTypes       Int? @map("ticket_types")
  coCurators        Int? @map("co_organisers")

  // Feature flags
  hasWaitlist        Boolean @default(false) @map("has_waitlist")
  hasBulkExport      Boolean @default(false) @map("has_bulk_export")
  hasAnalytics       Boolean @default(false) @map("has_analytics")
  hasWhatsappBlast   Boolean @default(false) @map("has_whatsapp_blast")
  hasRecurringEvents Boolean @default(false) @map("has_recurring_events")
  hasRemoveBranding  Boolean @default(false) @map("has_remove_branding")
  hasPrioritySupport Boolean @default(false) @map("has_priority_support")
  // Gates the whole Sessions feature: creating, listing and hosting them.
  hasSessions        Boolean @default(false) @map("has_sessions")
  // Gates the competitive dashboard (hack.unifesto.app): whether an event may
  // have a leaderboard at all. Per-event on/off lives on Leaderboard.enabled.
  hasLeaderboard     Boolean @default(false) @map("has_leaderboard")
  // Gates the certificate system: designing templates and issuing certificates.
  // Public verification stays open to everyone regardless of plan.
  hasCertificates    Boolean @default(false) @map("has_certificates")
  // Gates the sponsors & lead-generation feature: the space sponsor roster,
  // attaching sponsors to events, lead capture and the sponsor portal.
  hasSponsors        Boolean @default(false) @map("has_sponsors")

  // Fees & pricing
  /// Organiser platform fee % per paid ticket on this plan (A9, D10). Read by
  /// resolvePlatformFeePercent and the platform_fee_percent_for_event trigger
  /// function, so a change applies to new sales only (A21).
  platformFeePercent Decimal @default(0) @map("platform_fee_percent") @db.Decimal(5, 2)
  monthlyPrice         Int?    @map("monthly_price") // null = custom / contact sales
  annualPrice          Int?    @map("annual_price")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("plan_configs")
}

// Admin-editable definition of the non-subscription billing models
// (FREE and REVENUE_SHARE). Same limit/feature set as a plan, plus a default
// platform cut for revenue-share. Drives what those organisers can do.
model BillingModelConfig {
  billingModel BillingModel @id @map("billing_model")

  // For REVENUE_SHARE: the % prefilled when assigning this model.
  defaultRevenueSharePercent Decimal? @map("default_revenue_share_percent") @db.Decimal(5, 2)

  // Limits (null = unlimited)
  spaces            Int?
  eventsPerMonth    Int? @map("events_per_month")
  attendeesPerEvent Int? @map("attendees_per_event")
  ticketTypes       Int? @map("ticket_types")
  coCurators        Int? @map("co_organisers")

  // Feature flags
  hasWaitlist        Boolean @default(false) @map("has_waitlist")
  hasBulkExport      Boolean @default(false) @map("has_bulk_export")
  hasAnalytics       Boolean @default(false) @map("has_analytics")
  hasWhatsappBlast   Boolean @default(false) @map("has_whatsapp_blast")
  hasRecurringEvents Boolean @default(false) @map("has_recurring_events")
  hasRemoveBranding  Boolean @default(false) @map("has_remove_branding")
  hasPrioritySupport Boolean @default(false) @map("has_priority_support")
  // Gates the whole Sessions feature: creating, listing and hosting them.
  hasSessions        Boolean @default(false) @map("has_sessions")
  // Gates the competitive dashboard (hack.unifesto.app): whether an event may
  // have a leaderboard at all. Per-event on/off lives on Leaderboard.enabled.
  hasLeaderboard     Boolean @default(false) @map("has_leaderboard")
  // Gates the certificate system: designing templates and issuing certificates.
  hasCertificates    Boolean @default(false) @map("has_certificates")
  // Gates the sponsors & lead-generation feature (see PlanConfig.hasSponsors).
  hasSponsors        Boolean @default(false) @map("has_sponsors")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_model_configs")
}

// =====================================================
// EVENT MODELS
// Event management system
// =====================================================

model Event {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title         String  @db.VarChar(500)
  slug          String  @unique @db.VarChar(200)
  description   String? @db.Text
  coverImageUrl String? @map("cover_image_url") @db.Text

  type             EventType        @default(IN_PERSON)
  registrationType RegistrationType @default(RSVP) @map("registration_type")

  startDateTime DateTime @map("start_date_time") @db.Timestamptz(6)
  endDateTime   DateTime @map("end_date_time") @db.Timestamptz(6)
  timezone      String   @default("Asia/Kolkata") @db.VarChar(100)

  // Venue (IN_PERSON or HYBRID)
  venueName    String? @map("venue_name") @db.VarChar(255)
  venueAddress String? @map("venue_address") @db.Text
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  country      String? @default("India") @db.VarChar(100)
  latitude     Float?
  longitude    Float?

  // Online (ONLINE or HYBRID)
  onlineUrl      String? @map("online_url") @db.Text
  onlinePlatform String? @map("online_platform") @db.VarChar(100)

  // Registration
  capacity        Int?
  registeredCount Int     @default(0) @map("registered_count")
  waitlistEnabled Boolean @default(false) @map("waitlist_enabled")
  /// A33 (D11): the organiser absorbs the 5% buyer fee. Buyers pay the listed
  /// ticket price; the fee (capped at ₹99 a ticket) comes out of it, so the
  /// organiser's base is price − fee. Off = the fee is added on top.
  absorbProcessingFee Boolean @default(false) @map("absorb_processing_fee")
  waitlistCount   Int     @default(0) @map("waitlist_count")
  isFree          Boolean @default(true) @map("is_free")

  // Metadata
  tags       String[]
  /** Primary category (first of `categories`), kept for single-category readers. */
  category   String?         @db.VarChar(100)
  /** Every category the event is in, primary first (max 3). */
  categories String[]        @default([])
  visibility EventVisibility @default(PUBLIC)
  status     EventStatus     @default(DRAFT)

  // White-label branding (attendee-facing only). Rendered on the public event
  // page ONLY when `whiteLabelEnabled` (admin-approved via WhiteLabelRequest)
  // AND the space's plan still includes `hasRemoveBranding`. `brandLogoUrl`
  // falls back to the space's logo when null.
  whiteLabelEnabled Boolean @default(false) @map("white_label_enabled")
  brandColor        String? @map("brand_color") @db.VarChar(9)
  brandLogoUrl      String? @map("brand_logo_url") @db.Text

  // Manual attendee add: comping a PAID ticket (adding for free, i.e. NOT sending
  // a payment link) is blocked by default so the platform's processing fee is
  // never silently waived. A Platform Admin flips this on per-event by approving
  // a FreeAttendeeAddRequest; only then can an organiser uncheck "collect payment".
  allowFreeAttendeeAdd Boolean @default(false) @map("allow_free_attendee_add")

  // Recurring (event-calendar P2). Model A: an occurrence IS an Event row,
  // materialized from an RRULE held on a *series-parent* Event.
  //   - isRecurring = true marks a series-PARENT: a non-registerable template
  //     that is hidden from every attendee/space listing. Its `recurringRule`
  //     holds the RFC-5545 RRULE (e.g. "FREQ=WEEKLY;BYDAY=SA;COUNT=10").
  //   - An OCCURRENCE has isRecurring = false and `seriesParentId` pointing at
  //     its parent; it is a normal event with its own tickets/capacity/check-in.
  isRecurring   Boolean @default(false) @map("is_recurring")
  recurringRule String? @map("recurring_rule") @db.Text

  // Series ↔ occurrence relation, kept deliberately separate from the
  // parentEvent/EventHierarchy (festival sub-events) relation — an event may
  // not be both a recurring series and a festival sub-event in v1. SetNull so
  // deleting the parent template leaves its occurrences standing as ordinary
  // events rather than cascading them away.
  seriesParentId       String?   @map("series_parent_id") @db.Uuid
  seriesParent         Event?    @relation("EventSeries", fields: [seriesParentId], references: [id], onDelete: SetNull)
  seriesOccurrences    Event[]   @relation("EventSeries")
  // An occurrence that was edited individually ("this occurrence" edit scope):
  // whole-series regeneration must never overwrite it. Occurrences with any
  // registration are frozen regardless of this flag (D4).
  seriesDetached       Boolean   @default(false) @map("series_detached")
  // Rolling-window high-water mark on the PARENT: the far edge of the range we
  // have already materialized. The daily reconcile cron extends it forward.
  seriesGeneratedUntil DateTime? @map("series_generated_until") @db.Timestamptz(6)

  // Parent / sub-event hierarchy. A "big event" (parent) groups several
  // sub-events under one umbrella — a festival with its hackathon, workshops
  // and keynote. Registration stays per-event: the parent is a hub page that
  // lists its sub-events, each keeping its own tickets, capacity and check-in.
  //
  // One level deep by design: a sub-event may not itself be a parent, and both
  // ends must belong to the same space. `onDelete: SetNull` (not Cascade) so a
  // sub-event outlives its parent — hard-deleting a parent leaves its children
  // standing as ordinary events rather than dragging them down with it.
  parentEventId String? @map("parent_event_id") @db.Uuid
  parentEvent   Event?  @relation("EventHierarchy", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents   Event[] @relation("EventHierarchy")

  // L2 live Q&A: new questions wait for a moderator (true) or go straight up (false).
  qaPremoderated Boolean @default(true) @map("qa_premoderated")

  // L4 projector: random read-only display link secret. Regenerating it
  // revokes every screen opened with the old link. Null until first asked for.
  displayToken String? @map("display_token") @db.VarChar(64)

  // Private WhatsApp attendee invite group (organiser-pasted link). NEVER
  // returned on an unauthenticated path (stripped from `getEventBySlug`); it is
  // surfaced only through JWT-guarded per-registration endpoints and pushed to
  // attendees on registration/blast. A sub-event with no group of its own falls
  // back to its parent big event's attendee group. Validated + canonicalised via
  // common/whatsapp-links.ts (always a 'group').
  whatsappAttendeeGroupUrl String? @map("whatsapp_attendee_group_url") @db.Text

  // Attendee controls (curator / space admin, Event settings in the app).
  // Team leads may replace a claimed member of their group while this is on;
  // curators can always replace from Manage › Attendees.
  allowTeamChanges     Boolean   @default(false) @map("allow_team_changes")
  // Team changes (replace / add / remove members, hand over the lead) close at
  // this time; null = open until the event ends. Curators are never bound.
  teamChangesUntil     DateTime? @map("team_changes_until") @db.Timestamptz(6)
  // Attendees may edit their own registration answers (solo: theirs; group:
  // the lead the team's, each member their own) while this is on and before
  // `attendeeEditsUntil` (null = no deadline). Curators can always edit.
  attendeeEditsEnabled Boolean   @default(false) @map("attendee_edits_enabled")
  attendeeEditsUntil   DateTime? @map("attendee_edits_until") @db.Timestamptz(6)

  // Space
  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Creator
  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("EventCreator", fields: [createdBy], references: [id])

  // Default payout destination for this event. When set, payouts for the event
  // go here instead of the creator's primary account — this is how an organiser
  // routes a particular event's earnings to a co-organiser's account. Nullable:
  // unset falls back to the creator's verified primary. SetNull if the account
  // is deleted. Eligibility (creator or a space co/organiser) is enforced in
  // the service, not the DB.
  payoutBankAccountId String?            @map("payout_bank_account_id") @db.Uuid
  payoutBankAccount   PayoutBankAccount? @relation("EventPayoutAccount", fields: [payoutBankAccountId], references: [id], onDelete: SetNull)

  // Status timestamps
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.Text

  // Soft delete. A non-null `deletedAt` hides the event everywhere an
  // organiser or attendee could see it, without destroying anything: the
  // registrations, tickets, payments and payouts hanging off it all survive
  // and come back intact if it is restored.
  //
  // Distinct from CANCELLED, which is a public statement to attendees that the
  // event is off. Hiding is private housekeeping and says nothing to anyone —
  // which is why an event must be cancelled *before* it can be hidden.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Set when the daily job deleted this event's registration-question file
  // uploads (180 days after it ended). Null = files may still exist.
  formUploadsPurgedAt DateTime? @map("form_uploads_purged_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ticketTypes                    EventTicketType[]
  registrations                  EventRegistration[]
  agenda                         EventAgenda[]
  questions                      Question[]
  speakers                       EventSpeaker[]
  prizes                         EventPrize[]
  contacts                       EventContact[]
  faqs                           EventFaq[]
  formFields                     EventFormField[]
  payouts                        Payout[]
  refundRequests                 RefundRequest[]
  supportTickets                 SupportTicket[]
  userRoles                      UserRole[]
  checkinAccess                  EventCheckinAccess[]
  checkinTypes                   EventCheckinType[]
  coHosts                        EventCoHost[]
  ownershipTransfers             EventOwnershipTransfer[]
  subEventAttachRequestsAsParent SubEventAttachRequest[]  @relation("SubEventAttachParent")
  subEventAttachRequestsAsChild  SubEventAttachRequest[]  @relation("SubEventAttachChild")
  favoritedBy                    FavoriteEvent[]
  leaderboard                    Leaderboard?
  whiteLabelRequests             WhiteLabelRequest[]
  freeAttendeeAddRequests        FreeAttendeeAddRequest[]
  certificateTemplates           CertificateTemplate[]
  certificates                   Certificate[]
  reports                        EventReport[]
  eventSponsors                  EventSponsor[]
  leads                          Lead[]
  coupons                        EventCoupon[]
  partnerLinks                   EventPartnerLink[]
  pageViews                      PageView[]
  shortLinks                     ShortLink[]
  stays                          Stay[]
  stayBookings                   StayBooking[]
  polls                          Poll[]
  quizzes                        Quiz[]

  @@index([spaceId])
  @@index([status])
  @@index([startDateTime])
  @@index([slug])
  @@index([createdBy])
  // Every listing filters `deletedAt: null`, so it belongs in the hot indexes.
  @@index([deletedAt])
  @@index([categories], type: Gin)
  // Sub-event lookups (hub pages, management lists) filter by parent.
  @@index([parentEventId])
  // Series reconciliation lists occurrences by their parent.
  @@index([seriesParentId])
  // One occurrence per slot: replicas reconciling at once can't duplicate.
  @@unique([seriesParentId, startDateTime])
  @@index([payoutBankAccountId])
  @@map("events")
}

/// A user's saved / favourited event. One row per (user, event).
model FavoriteEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("favorite_events")
}

model EventTicketType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  freeAddRequests FreeAttendeeAddRequest[]
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String  @db.VarChar(255)
  description   String? @db.Text
  price         Decimal @db.Decimal(10, 2)
  currency      String  @default("INR") @db.VarChar(3)
  // null = unlimited capacity. RSVP + individual tickets are typically null.
  totalQuantity Int?    @map("total_quantity")
  soldCount     Int     @default(0) @map("sold_count")

  // Registration mechanism:
  //   RSVP       → one-click, free, no form.
  //   INDIVIDUAL → free/paid, one per person, optional custom form.
  //   GROUP      → free/paid, priced per-group or per-person, min/max group size.
  kind             TicketKind        @default(INDIVIDUAL)
  groupPricingMode GroupPricingMode? @map("group_pricing_mode")
  minGroupSize     Int?              @map("min_group_size")
  maxGroupSize     Int?              @map("max_group_size")

  saleStartsAt DateTime? @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt   DateTime? @map("sale_ends_at") @db.Timestamptz(6)
  perUserLimit Int       @default(1) @map("per_user_limit")

  // Waiting list. Only meaningful when totalQuantity is set — an unlimited
  // ticket never sells out, so it can never queue anyone. When this ticket is
  // full, registration attempts join the queue instead of failing.
  // Offering a spot holds the seat for waitlistOfferTtlHours; if the attendee
  // has not paid by then the offer expires and the seat returns to the pool.
  waitlistEnabled       Boolean @default(false) @map("waitlist_enabled")
  waitlistOfferTtlHours Int     @default(24) @map("waitlist_offer_ttl_hours")

  isVisible Boolean @default(true) @map("is_visible")
  isActive  Boolean @default(true) @map("is_active")
  order     Int     @default(0)

  // Per-ticket-type WhatsApp group invite link, so an organiser can run
  // separate groups per tier (e.g. VIP vs General, speakers vs attendees).
  // When set it takes precedence over the event's own group link for anyone on
  // this ticket; when null the attendee falls back to the event group, then the
  // (event/parent) community. Validated + canonicalised via common/whatsapp-links.ts.
  whatsappGroupUrl String? @map("whatsapp_group_url") @db.Text
  /// On a recurring occurrence: the series-parent ticket type this one copies
  /// (B17), so parent edits update it in place. Null everywhere else.
  sourceTicketTypeId String? @map("source_ticket_type_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  registrations EventRegistration[]
  formFields    EventFormField[]

  // Directional registration restrictions (organiser-configured). Holding a
  // ticket that lists T among its `blocks` makes T unavailable to that user.
  // `blocks` = rows where this ticket is the blocker; `blockedBy` = rows where
  // this ticket is the one made unavailable. The reverse direction is
  // independent: owning the blocked ticket does not prevent buying the blocker.
  blocks    TicketTypeBlock[] @relation("TicketBlocker")
  blockedBy TicketTypeBlock[] @relation("TicketBlocked")

  @@index([sourceTicketTypeId])
  @@index([eventId])
  @@map("event_ticket_types")
}

/// A directional exclusion between two ticket types of the same event:
/// a user who holds `blocker` cannot register for `blocked`.
model TicketTypeBlock {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  blockerId String          @map("blocker_id") @db.Uuid
  blocker   EventTicketType @relation("TicketBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String          @map("blocked_id") @db.Uuid
  blocked   EventTicketType @relation("TicketBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("ticket_type_blocks")
}

/// A discount code an organiser issues against one event. The discount reduces
/// the base ticket amount only; the processing fee is recomputed on the reduced
/// base, so a coupon never touches gateway economics, only what the organiser
/// collects.
///
/// Usage cap is enforced as a HARD reservation: `usedCount` is atomically
/// incremented when a buyer applies the code at checkout (holding a slot) and
/// decremented if that attempt is abandoned, fails, or its reservation lapses.
/// So `usedCount` == confirmed redemptions + slots currently held mid-checkout,
/// and `usageLimit` is never exceeded even under concurrent checkouts.
model EventCoupon {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Stored uppercased; unique per event (see @@unique below). Buyers type it at
  // checkout case-insensitively.
  code String @db.VarChar(64)

  description String? @db.Text

  discountType      CouponDiscountType @map("discount_type")
  // PERCENT: 0-100. FLAT: an amount in the ticket currency.
  discountValue     Decimal            @map("discount_value") @db.Decimal(10, 2)
  // Percentage coupons only: cap the money taken off. null = uncapped.
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(10, 2)
  // Minimum base ticket amount required for the code to apply. null = no floor.
  minPurchaseAmount Decimal?           @map("min_purchase_amount") @db.Decimal(10, 2)

  // Total redemptions allowed across all users. null = unlimited (no hard cap;
  // reservation still tracks usedCount for reporting but never blocks).
  usageLimit   Int? @map("usage_limit")
  // Redemptions a single user may make. Enforced against their confirmed +
  // reserved redemptions of this coupon.
  perUserLimit Int  @default(1) @map("per_user_limit")
  // Confirmed redemptions + slots held mid-checkout. Source of truth for the cap.
  usedCount    Int  @default(0) @map("used_count")

  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  // Restrict the code to specific ticket types. Empty = applies to every ticket
  // type of the event.
  appliesToTicketTypeIds String[] @map("applies_to_ticket_type_ids") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions CouponRedemption[]

  @@unique([eventId, code])
  @@index([eventId])
  @@map("event_coupons")
}

/// One application of a coupon to one registration. Holds the reservation
/// lifecycle the coupon's `usedCount` counter cannot express on its own, and is
/// the row the TTL sweep scans to release stale RESERVED slots.
model CouponRedemption {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  couponId String      @map("coupon_id") @db.Uuid
  coupon   EventCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  registrationId String            @unique @map("registration_id") @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Money actually taken off the base amount by this redemption.
  discountAmount Decimal @map("discount_amount") @db.Decimal(10, 2)

  status        CouponRedemptionStatus @default(RESERVED)
  // While RESERVED, the deadline past which the sweep releases the held slot.
  // Cleared to null on CONFIRMED.
  reservedUntil DateTime?              @map("reserved_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([couponId])
  @@index([userId])
  // The TTL sweep scans RESERVED rows past their deadline.
  @@index([status, reservedUntil])
  @@map("coupon_redemptions")
}

model EventAgenda {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String   @db.VarChar(500)
  description String?  @db.Text
  startTime   DateTime @map("start_time") @db.Timestamptz(6)
  endTime     DateTime @map("end_time") @db.Timestamptz(6)
  speakerName String?  @map("speaker_name") @db.VarChar(255)
  order       Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  questions Question[]

  @@index([eventId])
  @@map("event_agenda")
}

/// L2 live Q&A. PENDING waits for a moderator (pre-moderated events only);
/// APPROVED is up for votes; ANSWERED sinks below the open ones; HIDDEN is
/// gone for everyone but organisers.
enum QuestionStatus {
  PENDING
  APPROVED
  HIDDEN
  ANSWERED

  @@map("question_status")
}

/// An attendee's question during an event, optionally about one agenda item
/// (the event's session/track). Sub-events are their own events, so their
/// Q&A is separate already.
model Question {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  agendaId String?      @map("agenda_id") @db.Uuid
  agenda   EventAgenda? @relation(fields: [agendaId], references: [id], onDelete: SetNull)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text       String         @db.VarChar(500)
  status     QuestionStatus @default(PENDING)
  pinned     Boolean        @default(false)
  answeredAt DateTime?      @map("answered_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  votes QuestionVote[]

  @@index([eventId, status])
  // The ask rate limit counts one person's recent questions on an event.
  @@index([eventId, userId, createdAt])
  @@map("questions")
}

/// One upvote. The unique (question, user) is what makes it one each.
model QuestionVote {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([questionId, userId])
  @@map("question_votes")
}

model EventSpeaker {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  bio         String? @db.Text
  avatarUrl   String? @map("avatar_url") @db.Text
  designation String? @db.VarChar(255)
  company     String? @db.VarChar(255)
  linkedinUrl String? @map("linkedin_url") @db.Text
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId])
  @@map("event_speakers")
}

// Prizes / Takeaways — what attendees win or walk away with (rank, reward,
// swag, certificates, learning outcomes).
model EventPrize {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(500)
  description String? @db.Text
  rank        String? @db.VarChar(100) // e.g. "1st Prize", "Runner-up", "Takeaway"
  value       String? @db.VarChar(255) // e.g. "₹50,000", "Certificate + Swag"
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId])
  @@map("event_prizes")
}

// Contact — points of contact for the event (organiser desk, coordinators).
model EventContact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name  String  @db.VarChar(255)
  role  String? @db.VarChar(255) // e.g. "Event Coordinator"
  email String? @db.VarChar(255)
  phone String? @db.VarChar(50)
  order Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

