// =====================================================
// PAYOUT SYSTEM
// Organiser bank accounts and settlement records
// =====================================================

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("payout_status")
}

enum BankAccountStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("bank_account_status")
}

/// How an organiser is paid out. A payout method is EITHER a full bank account
/// (holder name + number + IFSC + bank) OR a UPI handle (upiId + payee name) —
/// the two are stored side by side but only one set of fields is filled per row.
/// `accountHolderName` doubles as the UPI payee name, and `mobileNumber` (the
/// number linked to the account/UPI) is captured for both.
enum PayoutMethodType {
  BANK
  UPI

  @@map("payout_method_type")
}

model PayoutBankAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // BANK or UPI. Determines which of the field groups below is populated.
  methodType PayoutMethodType @default(BANK) @map("method_type")

  // Holder name for a bank account, or the payee name for a UPI handle. Always set.
  accountHolderName String  @map("account_holder_name") @db.VarChar(255)
  // Mobile number linked to the account / UPI. Captured for both types.
  mobileNumber      String? @map("mobile_number") @db.VarChar(20)

  // Bank fields — populated when methodType = BANK.
  accountNumber String? @map("account_number") @db.VarChar(50)
  ifscCode      String? @map("ifsc_code") @db.VarChar(20)
  bankName      String? @map("bank_name") @db.VarChar(255)
  accountType   String  @default("savings") @map("account_type") @db.VarChar(20)

  // UPI field — populated when methodType = UPI.
  upiId String? @map("upi_id") @db.VarChar(100)

  status          BankAccountStatus @default(PENDING)
  verifiedAt      DateTime?         @map("verified_at") @db.Timestamptz(6)
  verifiedBy      String?           @map("verified_by") @db.Uuid
  rejectionReason String?           @map("rejection_reason") @db.Text

  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payouts             Payout[]
  // Events that route their payout to this account by default (may be a
  // co-organiser's account). SetNull if the account is removed.
  eventPayoutDefaults Event[]  @relation("EventPayoutAccount")

  @@index([userId])
  @@index([status])
  @@map("organiser_bank_accounts")
}

model Payout {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation("PayoutUser", fields: [userId], references: [id])

  bankAccountId String            @map("bank_account_id") @db.Uuid
  bankAccount   PayoutBankAccount @relation(fields: [bankAccountId], references: [id])

  grossRevenue       Decimal @map("gross_revenue") @db.Decimal(12, 2)
  platformFeePercent Decimal @map("platform_fee_percent") @db.Decimal(5, 2)
  platformFee        Decimal @map("platform_fee") @db.Decimal(12, 2)
  netAmount          Decimal @map("net_amount") @db.Decimal(12, 2)

  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)

  status        PayoutStatus @default(PENDING)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  failedAt      DateTime?    @map("failed_at") @db.Timestamptz(6)
  failureReason String?      @map("failure_reason") @db.Text

  utr String? @db.VarChar(50)

  createdBy String? @map("created_by") @db.Uuid
  notes     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@map("payouts")
}

/// A refund request for a paid registration. Two-stage approval: an attendee
/// raises it (PENDING_CURATOR) → the organiser forwards or rejects → an admin
/// approves (issuing the refund) or rejects. Organisers may also raise a request
/// directly, which starts at PENDING_ADMIN. Only the base amount (ticket price)
/// is ever refundable — the processing fee is retained. Partial refunds allowed.
model RefundRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  registrationId String            @map("registration_id") @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  requestedById String              @map("requested_by_id") @db.Uuid
  requestedBy   User                @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  requesterRole RefundRequesterRole @map("requester_role")

  supportTicketId String?        @map("support_ticket_id") @db.Uuid
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  reason          String   @db.Text
  requestedAmount Decimal? @map("requested_amount") @db.Decimal(10, 2)

  // Where the attendee wants the cash portion returned (default: bank).
  refundMethod RefundMethod @default(BANK) @map("refund_method")

  status RefundStatus @default(PENDING_CURATOR)

  // Organiser verification stage
  curatorNote     String?   @map("organiser_note") @db.Text
  curatorActionBy String?   @map("organiser_action_by") @db.Uuid
  curatorActionAt DateTime? @map("organiser_action_at") @db.Timestamptz(6)

  // Admin decision stage
  adminNote     String?   @map("admin_note") @db.Text
  adminActionBy String?   @map("admin_action_by") @db.Uuid
  adminActionAt DateTime? @map("admin_action_at") @db.Timestamptz(6)

  // Settlement — populated when APPROVED
  approvedAmount   Decimal? @map("approved_amount") @db.Decimal(10, 2)
  cashRefunded     Decimal  @default(0) @map("cash_refunded") @db.Decimal(10, 2)
  razorpayRefundId String?  @map("razorpay_refund_id") @db.VarChar(100)
  /// Set when this refund landed after the event was already paid out past
  /// what it now earns: the amount the platform must recover from the space.
  payoutShortfall  Decimal? @map("payout_shortfall") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([registrationId])
  @@index([eventId])
  @@index([status])
  // At most one open (PENDING_CURATOR / PENDING_ADMIN / PROCESSING) request per
  // registration: partial unique index refund_requests_one_open_per_registration
  // (migration 20261015130001). Prisma can't express it here.
  @@map("refund_requests")
}

// =====================================================
// API REQUEST LOG (admin observability)
// =====================================================

// One row per HTTP request handled by the API. Written async by a global
// interceptor; surfaced in the admin "Logs" section. Retained ~14 days.
model ApiLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  method     String @db.VarChar(10)
  path       String @db.Text
  statusCode Int    @map("status_code")
  durationMs Int    @map("duration_ms")

  userId       String? @map("user_id") @db.Uuid
  ipAddress    String? @map("ip_address") @db.VarChar(64)
  userAgent    String? @map("user_agent") @db.Text
  errorMessage String? @map("error_message") @db.Text
  /// How many requests this row stands for (2xx GETs are sampled, S27).
  weight       Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([statusCode])
  @@index([method])
  @@index([userId])
  @@index([statusCode, createdAt])
  @@index([userId, createdAt])
  // Prefix search (logs.service `startsWith`) under a non-C collation.
  @@index([path(ops: raw("text_pattern_ops"))], map: "api_logs_path_prefix_idx")
  @@map("api_logs")
}

// =====================================================
// STATUS PAGE (uptime history + incidents)
// =====================================================

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED

  @@map("incident_status")
}

enum IncidentImpact {
  NONE // maintenance / informational
  MINOR
  MAJOR
  CRITICAL

  @@map("incident_impact")
}

// A single health probe result for one service, sampled on a schedule.
// Aggregated into daily uptime for the 90-day status bars.
model HealthCheck {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  service   String   @db.VarChar(50) // api | database | redis | storage
  up        Boolean
  latencyMs Int?     @map("latency_ms")
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@index([service, checkedAt])
  @@map("health_checks")
}

model Incident {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title  String         @db.VarChar(300)
  body   String?        @db.Text
  status IncidentStatus @default(INVESTIGATING)
  impact IncidentImpact @default(MINOR)

  affectedServices String[] @map("affected_services")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("incidents")
}

// =====================================================
// SUPPORT (ticket-based helpdesk)
// =====================================================

model SupportTicket {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Human-friendly reference, e.g. #1042
  ticketNumber Int    @unique @default(autoincrement()) @map("ticket_number")

  // Content
  subject  String                @db.VarChar(300)
  category SupportTicketCategory @default(GENERAL)
  priority SupportTicketPriority @default(NORMAL)
  status   SupportTicketStatus   @default(OPEN)

  // Who raised it
  requesterId  String  @map("requester_id") @db.Uuid
  requester    User    @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  // Optional reply-to captured at creation (mobile attendees, unverified email)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  // App build it was raised from: version, build, runtime, OTA update id, platform.
  clientInfo   Json?   @map("client_info")

  // Optional space context (tickets raised from an organiser space)
  spaceId String? @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Assist case shape
  kind        SupportCaseKind @default(HELP)
  requestType String?         @map("request_type") @db.VarChar(60) // REQUEST kind only
  desk        SupportDesk     @default(PLATFORM)
  // The typed record this case wraps, e.g. RefundRequest / SpaceRequest.
  subjectType String?         @map("subject_type") @db.VarChar(40)
  subjectId   String?         @map("subject_id") @db.Uuid

  // Event / registration context
  eventId        String?            @map("event_id") @db.Uuid
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registrationId String?            @map("registration_id") @db.Uuid
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  // Staff assignment
  assignedToId String? @map("assigned_to_id") @db.Uuid
  assignedTo   User?   @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Lifecycle
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)

  // Assist SLA + read state per side
  escalatedAt         DateTime? @map("escalated_at") @db.Timestamptz(6)
  firstResponseAt     DateTime? @map("first_response_at") @db.Timestamptz(6)
  requesterLastReadAt DateTime? @map("requester_last_read_at") @db.Timestamptz(6)
  deskLastReadAt      DateTime? @map("desk_last_read_at") @db.Timestamptz(6)

  rating        Int?    @db.SmallInt // requester's 1-5 rating once resolved
  ratingComment String? @map("rating_comment") @db.VarChar(1000) // D20: optional words with the rating
  aiTriage      Json?   @map("ai_triage")
  aiSummary     String? @map("ai_summary") @db.Text
  // D15: the lastMessageAt the summary covers; older than lastMessageAt = stale.
  aiSummaryAt   DateTime? @map("ai_summary_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages       SupportMessage[]
  refundRequests RefundRequest[]

  @@index([requesterId])
  @@index([spaceId])
  @@index([assignedToId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([desk, status])
  @@index([eventId])
  @@index([subjectType, subjectId])
  @@map("support_tickets")
}

/// D19: a saved reply the desk inserts into the composer. No space = the Unifesto desk's.
model CannedReply {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId String? @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title   String  @db.VarChar(100)
  body    String  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@map("canned_replies")
}

model SupportMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ticketId String        @map("ticket_id") @db.Uuid
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Legacy: true when written by staff. Superseded by `side`; still written
  // so older clients keep working.
  isStaffReply Boolean            @default(false) @map("is_staff_reply")
  side         SupportMessageSide @default(REQUESTER)
  internal     Boolean            @default(false) // desk-only note, hidden from the requester
  aiDrafted    Boolean            @default(false) @map("ai_drafted")
  /// D14: action cards on an Assist bot message (request a refund, cancel), confirmed by the person in the app.
  actions      Json?

  body String @db.Text

  attachments SupportAttachment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("support_messages")
}

/// A file on an Assist message. Stored under private/ in S3, only ever served
/// by a short-lived signed URL to people who can see the case.
model SupportAttachment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  messageId String         @map("message_id") @db.Uuid
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  key  String @db.VarChar(300) // private S3 key
  name String @db.VarChar(200) // original filename, for the download
  mime String @db.VarChar(100)
  size Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([messageId])
  @@map("support_attachments")
}

// =====================================================
// SESSIONS
// Lightweight, online-only gatherings owned by a Space (Meet/Zoom/Teams).
// Deliberately separate from Event: no tickets, QR, forms, or groups — just a
// title, a time, a meeting link, and (optionally) a single price. Offline
// gatherings stay under Event.
// =====================================================

enum SessionPlatform {
  GOOGLE_MEET
  ZOOM
  MS_TEAMS
  OTHER
  UNIFESTO_LIVE // hosted in-app via 100ms; join is a per-user token, not a URL

  @@map("session_platform")
}

enum SessionStatus {
  DRAFT // not yet visible to attendees
  PUBLISHED // open for registration
  CANCELLED // organiser cancelled; paid attendees auto-refunded
  COMPLETED // ended

  @@map("session_status")
}

enum SessionVisibility {
  PUBLIC // surfaced in discovery
  UNLISTED // reachable only via direct link

  @@map("session_visibility")
}

model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title         String  @db.VarChar(500)
  slug          String  @unique @db.VarChar(200)
  description   String? @db.Text
  coverImageUrl String? @map("cover_image_url") @db.Text

  // Where it happens. For external platforms the meeting link is gated: never
  // returned to non-registered users (enforced in the service layer, not here).
  // For UNIFESTO_LIVE there is no shareable URL at all — meetingUrl is null and
  // the room is joined with a per-user LiveKit token minted at join() time (the
  // room name is derived from the session id, so nothing is stored here).
  platform      SessionPlatform @default(GOOGLE_MEET)
  meetingUrl    String?         @map("meeting_url") @db.Text
  platformOther String?         @map("platform_other") @db.VarChar(100)

  // When it happens. Stored as start + duration rather than start + end so the
  // "join window" (link goes hot shortly before start) is a pure function of
  // startDateTime.
  startDateTime   DateTime @map("start_date_time") @db.Timestamptz(6)
  durationMinutes Int      @default(60) @map("duration_minutes")
  timezone        String   @default("Asia/Kolkata") @db.VarChar(100)

  // Registration. null capacity = unlimited. price 0 (the default) = free, in
  // which case registration completes without a Razorpay round-trip.
  capacity        Int?
  registeredCount Int     @default(0) @map("registered_count")
  price           Decimal @default(0) @db.Decimal(10, 2)
  currency        String  @default("INR") @db.VarChar(3)

  status     SessionStatus     @default(DRAFT)
  visibility SessionVisibility @default(PUBLIC)

  // For UNIFESTO_LIVE: true = interactive (attendees may publish mic/cam),
  // false = broadcast/webinar (only the host publishes). Ignored for external.
  interactive Boolean @default(true)

  // Populated after the session ends (optional). recordingEgressId tracks an
  // in-flight LiveKit Egress so it can be stopped and correlated on completion.
  recordingUrl      String? @map("recording_url") @db.Text
  recordingEgressId String? @map("recording_egress_id") @db.Text

  // Cancellation (organiser-initiated). See cancellation-policy in the service.
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.Text

  // Soft delete — see the matching fields on Event. Hides the session without
  // touching its registrations, payments or recording.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("SessionCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  registrations SessionRegistration[]
  coHosts       SessionCoHost[]

  @@index([spaceId])
  @@index([slug])
  @@index([status])
  @@index([startDateTime])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("sessions")
}

/// Per-session co-hosts: users the organiser invites to host a single session
/// (e.g. a guest speaker) without making them a space-level co-organiser. They
/// receive a host token when they join, and cannot register as attendees.
model SessionCoHost {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_co_hosts")
}

model SessionRegistration {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Payment. Mirrors the money columns on EventRegistration —
  // sessions are Razorpay-only in v1. razorpayAmount == totalAmount for now.
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  razorpayAmount Decimal       @default(0) @map("razorpay_amount") @db.Decimal(10, 2)
  processingFee  Decimal       @default(0) @map("processing_fee") @db.Decimal(10, 2)
  refundedAmount Decimal       @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentId      String?       @unique @map("payment_id") @db.VarChar(255)
  orderId        String?       @map("order_id") @db.VarChar(255)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// Set when this payment must go back (session cancelled, or it filled up
  /// while being paid). Claimed before Razorpay is called; a retry job clears it.
  refundDueAt    DateTime?     @map("refund_due_at") @db.Timestamptz(6)

  status RegistrationStatus @default(REGISTERED)

  // Attendance: stamped the first time the attendee follows the join redirect.
  // The online analogue of a QR check-in (measures intent-to-join, not presence).
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(6)

  registeredAt DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([orderId])
  @@map("session_registrations")
}

// =====================================================
// LEADERBOARD / COMPETITIVE DASHBOARD MODELS
// Powers hack.unifesto.app. Exactly one Leaderboard per event, in one of two
// modes:
//   RUBRIC – judges score entrants against weighted criteria; an entrant's
//            final score is the weighted-criteria total, averaged across the
//            judges who scored them.
//   METRIC – organisers enter raw values for metric fields; entrants are
//            ranked by the single field flagged `isPrimary`.
// Availability is gated by PlanConfig.hasLeaderboard; the per-event on/off
// switch is Leaderboard.enabled.
//
// Cross-aggregate links (entrant → user/registration, score → judge) are
// stored as bare UUID columns without a Prisma relation, mirroring the
// existing `reviewed_by` / soft-reference convention. Referential integrity
// is enforced with real FKs *within* the leaderboard aggregate only.
// =====================================================

enum LeaderboardMode {
  RUBRIC
  METRIC

  @@map("leaderboard_mode")
}

enum LeaderboardEntrantKind {
  TEAM
  INDIVIDUAL

  @@map("leaderboard_entrant_kind")
}

enum LeaderboardVisibility {
  PUBLIC // anyone with the link, unauthenticated
  PARTICIPANTS_ONLY // authenticated users registered for the event

  @@map("leaderboard_visibility")
}

enum LeaderboardStatus {
  DRAFT // organiser-only; not shown on the public board
  LIVE // visible per `visibility`; ranks update in real time
  FROZEN // visible, but score changes stop reflecting (pre-reveal suspense)
  FINAL // results revealed and locked

  @@map("leaderboard_status")
}

enum LeaderboardTieBreak {
  EARLIEST_SUBMISSION // equal totals ordered by who reached the score first
  PRIMARY_METRIC // broken by `tieBreakMetricId`, then earliest submission

  @@map("leaderboard_tie_break")
}

enum LeaderboardRoundStatus {
  PENDING // not started; not scoreable, hidden from panelists
  ACTIVE // open for scoring/reviews; panelists may read + write their own cells
  CLOSED // scoring done; server-side read-lock — panelists can no longer read

  @@map("leaderboard_round_status")
}

enum LeaderboardEntrantRoundStatus {
  PENDING // undecided in this round (the default the bracket shows)
  ADVANCED // curator advanced this entrant to the next round
  ELIMINATED // curator eliminated this entrant in this round

  @@map("leaderboard_entrant_round_status")
}

enum LeaderboardPanelistKind {
  JUDGE // scores + per-criterion comments + overall review
  MENTOR // reviews only — never a numeric score

  @@map("leaderboard_panelist_kind")
}

// ── Hackathon mode (docs/hackathon-mobile-plan.md) ──
// A hackathon is a RUBRIC board with `isHackathon = true`: entrants are teams
// imported from GROUP registrations, each with a curator-patterned Team ID.

enum HackathonPsMode {
  TEAM_WRITES // the team writes its own problem statement
  TEAM_PICKS // the team picks one from the curator's list
  CURATOR_ASSIGNS // the curator assigns one from the list

  @@map("hackathon_ps_mode")
}

enum HackathonThemeMode {
  LIST // dropdown of the curator's themes
  TEXT // short free text

  @@map("hackathon_theme_mode")
}

enum HackathonScoringMode {
  PER_ROUND // final ranking = the last scored round
  CUMULATIVE // total = sum of the counted rounds' scores

  @@map("hackathon_scoring_mode")
}

enum HackathonTeamNameSource {
  FORM // the linked per-group registration question
  LEAD // set by the team lead in the app
  CURATOR // set by the curator
  DEFAULT // "<lead name>'s team"

  @@map("hackathon_team_name_source")
}

enum HackathonRoundKind {
  EVALUATION // judges give marks against criteria
  MENTORING // mentors give written feedback only: no marks, no elimination

  @@map("hackathon_round_kind")
}

enum HackathonHelpQueryStatus {
  OPEN // raised, nobody on it yet
  ACKNOWLEDGED // someone from the event team is on it
  RESOLVED

  @@map("hackathon_help_query_status")
}

enum HackathonAnnouncementAudience {
  ALL // every team member and every judge / mentor
  TEAMS // every team member
  JUDGES // judges and mentors
  ROOM // members of the teams in one room

  @@map("hackathon_announcement_audience")
}

enum HackathonJudgingMode {
  SINGLE // one judge evaluates each team
  PANEL // a panel sits together: one slot, every member marks
  MULTI // the team collects `requiredEvaluations` separate evaluations

  @@map("hackathon_judging_mode")
}

/// Where a team's evaluation request is. WAITING…AWAITING_MARKS are "open":
/// a team has at most one open request (partial unique index in the migration).
enum HackathonEvalStatus {
  WAITING // in the judge's / panel's queue
  CALLED // the judge called the team; it's on its way
  IN_PROGRESS // the slot is running (slotEndsAt set)
  AWAITING_MARKS // the slot ran out; the judge still has to submit
  COMPLETED // marks submitted (or the curator force-completed it)
  NO_SHOW // called, didn't turn up within the grace time
  WITHDRAWN // the team left the queue
  CANCELLED // removed by the curator, or the round closed / team cancelled

  @@map("hackathon_eval_status")
}

model Leaderboard {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // One board per event.
  eventId String @unique @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  mode        LeaderboardMode
  entrantKind LeaderboardEntrantKind @default(TEAM) @map("entrant_kind")
  visibility  LeaderboardVisibility  @default(PARTICIPANTS_ONLY)
  status      LeaderboardStatus      @default(DRAFT)

  // Per-event on/off, independent of the plan-level capability gate.
  enabled Boolean @default(false)

  // Curator toggle that opens written feedback to participants (their OWN team
  // only). Marks are NEVER shown to participants regardless of this flag.
  revealReviews Boolean @default(false) @map("reveal_reviews")

  title       String? @db.VarChar(200)
  description String? @db.Text

  // How equal `totalScore`s are ordered.
  tieBreak         LeaderboardTieBreak @default(EARLIEST_SUBMISSION) @map("tie_break")
  // Used only when tieBreak = PRIMARY_METRIC. Soft reference to a metric.
  tieBreakMetricId String?             @map("tie_break_metric_id") @db.Uuid

  // ── Hackathon mode ──
  isHackathon     Boolean @default(false) @map("is_hackathon")
  // Team ID pattern: prefix + zero-padded counter, e.g. "HACK25-" + 3 → HACK25-001.
  teamCodePrefix  String? @map("team_code_prefix") @db.VarChar(20)
  teamCodeDigits  Int     @default(3) @map("team_code_digits")
  // Next number to hand out. Only ever moves forward, so an ID is never reused.
  teamCodeNext    Int     @default(1) @map("team_code_next")
  // Per-group registration question whose answer becomes the team name (soft
  // ref → EventFormField). Null = the lead names the team, else a default.
  teamNameFieldId String? @map("team_name_field_id") @db.Uuid

  psMode                HackathonPsMode?     @map("ps_mode")
  themeMode             HackathonThemeMode   @default(LIST) @map("theme_mode")
  psDeadline            DateTime?            @map("ps_deadline") @db.Timestamptz(6)
  // The deadline the "1 hour left" reminder was sent for. Moving the deadline
  // makes it differ again, so teams are reminded about the new one.
  psDeadlineRemindedFor DateTime?            @map("ps_deadline_reminded_for") @db.Timestamptz(6)
  scoringMode           HackathonScoringMode @default(PER_ROUND) @map("scoring_mode")

  // Hackathon venue. All null = fall back to the event's own venue.
  venueName    String? @map("venue_name") @db.VarChar(255)
  venueAddress String? @map("venue_address") @db.Text
  venueLat     Float?  @map("venue_lat")
  venueLng     Float?  @map("venue_lng")
  venueMapUrl  String? @map("venue_map_url") @db.Text
  venueNotes   String? @map("venue_notes") @db.Text

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  metrics       LeaderboardMetric[]
  entrants      LeaderboardEntrant[]
  rounds        LeaderboardRound[]
  panelists     LeaderboardPanelist[]
  awards        LeaderboardAward[]
  rooms         HackathonRoom[]
  themes        HackathonTheme[]
  statements    HackathonStatement[]
  judgeProfiles HackathonJudgeProfile[]
  panels        HackathonPanel[]
  evalRequests  HackathonEvalRequest[]
  announcements HackathonAnnouncement[]
  helpTopics    HackathonHelpTopic[]
  helpQueries   HackathonHelpQuery[]

  @@map("leaderboards")
}

model LeaderboardMetric {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  // Criteria may differ per round. null = board-level (applies to all rounds).
  // Kept null-able so a board with one implicit round needs no round wiring.
  roundId String?           @map("round_id") @db.Uuid
  round   LeaderboardRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)

  key   String @db.VarChar(80) // stable slug, unique within a board
  label String @db.VarChar(160)

  // RUBRIC: relative weight in the weighted average. METRIC: ignored.
  weight Decimal @default(1) @db.Decimal(6, 3)

  // Allowed range for a single score cell.
  minValue Decimal @default(0) @map("min_value") @db.Decimal(12, 3)
  maxValue Decimal @default(100) @map("max_value") @db.Decimal(12, 3)

  // METRIC mode: the one field entrants are ranked by (enforce exactly one
  // per board in application logic).
  isPrimary Boolean @default(false) @map("is_primary")

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scores LeaderboardScore[]

  @@unique([leaderboardId, key])
  @@index([leaderboardId])
  @@index([roundId])
  @@map("leaderboard_metrics")
}

model LeaderboardEntrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  name String @db.VarChar(200)

  // Optional soft links (no DB FK). A team can map to a paid group ticket, or
  // an individual to their account — but neither is required, so teams may
  // form after registration or outside ticketing entirely.
  registrationId String? @map("registration_id") @db.Uuid
  userId         String? @map("user_id") @db.Uuid

  // Free-form roster / project metadata (member names, repo link, table #, …).
  meta Json?

  // Denormalised cache recomputed on each score write, for O(1) board reads.
  totalScore Decimal @default(0) @map("total_score") @db.Decimal(14, 4)
  rank       Int?

  // ── Hackathon team (null on other boards) ──
  // Unique per board. Kept after cancellation so it is never handed out again.
  teamCode       String?                  @map("team_code") @db.VarChar(40)
  // The counter value the code was minted from; orders teams by import.
  teamSeq        Int?                     @map("team_seq")
  teamNameSource HackathonTeamNameSource? @map("team_name_source")
  // Stamped when the linked registration is found cancelled; cleared if it is
  // restored. The team keeps its code and shows as cancelled.
  cancelledAt    DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  roomId         String?                  @map("room_id") @db.Uuid
  room           HackathonRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // ── Hackathon problem statement + theme ──
  // Either one from the curator's list (statementId) or the team's own
  // (customStatementTitle/Text). Theme is from the list (themeId) or free text.
  statementId                 String?             @map("statement_id") @db.Uuid
  statement                   HackathonStatement? @relation(fields: [statementId], references: [id], onDelete: NoAction)
  customStatementTitle        String?             @map("custom_statement_title") @db.VarChar(200)
  customStatementText         String?             @map("custom_statement_text") @db.Text
  themeId                     String?             @map("theme_id") @db.Uuid
  theme                       HackathonTheme?     @relation(fields: [themeId], references: [id], onDelete: NoAction)
  themeText                   String?             @map("theme_text") @db.VarChar(60)
  // Set when the statement is locked in (by the team, or assigned by the
  // curator). Opens the hackathon for the team; null = still choosing.
  statementLockedAt           DateTime?           @map("statement_locked_at") @db.Timestamptz(6)
  // Who locked it: a team member, or the curator who assigned it.
  statementSetBy              String?             @map("statement_set_by") @db.Uuid
  // Stamped when the curator changes the statement/theme after the team had a
  // submitted evaluation; the curator's results show "changed after evaluation".
  statementChangedAfterEvalAt DateTime?           @map("statement_changed_after_eval_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scores         LeaderboardScore[]
  entrantRounds  LeaderboardEntrantRound[]
  judgments      LeaderboardJudgment[]
  panelistScopes LeaderboardPanelist[]
  awards         LeaderboardAward[]
  evalRequests   HackathonEvalRequest[]
  submissions    HackathonSubmission[]
  helpQueries    HackathonHelpQuery[]

  @@unique([leaderboardId, teamCode])
  @@index([leaderboardId])
  @@index([registrationId])
  @@index([roomId])
  @@index([statementId])
  @@index([themeId])
  @@map("leaderboard_entrants")
}

model LeaderboardScore {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  metricId String            @map("metric_id") @db.Uuid
  metric   LeaderboardMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  // The round this cell belongs to. Every score is round-scoped; a board with
  // no explicit rounds carries an implicit "Round 1" materialised on create, so
  // this is always a real round.
  roundId String           @map("round_id") @db.Uuid
  round   LeaderboardRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // RUBRIC: the judge who owns this cell. METRIC: null (organiser-entered).
  // NOTE: the @@unique below does NOT constrain the METRIC case, because
  // Postgres treats NULLs as distinct in unique indexes. A partial unique
  // index `(entrant_id, metric_id) WHERE judge_user_id IS NULL` is added by
  // hand in the migration to guarantee one organiser row per cell.
  judgeUserId String? @map("judge_user_id") @db.Uuid

  value Decimal @db.Decimal(12, 3)

  // Optional per-criterion note the judge leaves alongside the numeric cell.
  comment String? @db.Text

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // One cell per (entrant, metric, judge, round). METRIC cells have
  // judgeUserId = null; Postgres treats NULLs as distinct here, so a partial
  // unique index `(entrant, metric, round) WHERE judge_user_id IS NULL` is added
  // by hand in the migration to guarantee one organiser row per cell per round.
  @@unique([entrantId, metricId, judgeUserId, roundId], map: "leaderboard_scores_cell_round_uniq")
  @@index([entrantId])
  @@index([metricId])
  @@index([judgeUserId])
  @@index([roundId])
  @@map("leaderboard_scores")
}

/// A named stage of a competition (Screening → Semis → Finals). Rounds are
/// optional and multi-round; a board with no explicit rounds carries one
/// implicit "Round 1" the service materialises on board create, so scoring code
/// always has a `roundId` to key on. Scores are INDEPENDENT per round; final
/// ranking is the last round's ranking.
model LeaderboardRound {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(160)
  order Int

  status LeaderboardRoundStatus @default(PENDING)

  startAt DateTime? @map("start_at") @db.Timestamptz(6)
  // Hackathon: after this, teams can't join a queue; teams already waiting
  // are still evaluated and the curator closes the round.
  endAt   DateTime? @map("end_at") @db.Timestamptz(6)

  // ── Hackathon round settings (ignored on other boards) ──
  // MENTORING rounds use mentors and take no marks; they never eliminate or count.
  kind                HackathonRoundKind   @default(EVALUATION)
  judgingMode         HackathonJudgingMode @default(SINGLE) @map("judging_mode")
  // MULTI: how many separate evaluations (distinct judges) a team needs.
  // MENTORING: how many sessions (distinct mentors) a team may have.
  requiredEvaluations Int                  @default(1) @map("required_evaluations")
  slotMinutes         Int                  @default(10) @map("slot_minutes")
  // How long a called team has to turn up before the judge may mark a no-show.
  callGraceMinutes    Int                  @default(3) @map("call_grace_minutes")
  // Off: no advance/eliminate; every team goes on to the next round.
  eliminationEnabled  Boolean              @default(true) @map("elimination_enabled")
  // CUMULATIVE scoring adds up only rounds with this on.
  countsTowardTotal   Boolean              @default(true) @map("counts_toward_total")
  // Teams can edit their project links for this round until then (else until it closes).
  submissionsCloseAt  DateTime?            @map("submissions_close_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  metrics       LeaderboardMetric[]
  scores        LeaderboardScore[]
  entrantRounds LeaderboardEntrantRound[]
  panelists     LeaderboardPanelist[]
  judgments     LeaderboardJudgment[]
  panels        HackathonPanel[]
  evalRequests  HackathonEvalRequest[]
  submissions   HackathonSubmission[]

  @@unique([leaderboardId, order])
  @@index([leaderboardId])
  @@map("leaderboard_rounds")
}

/// One entrant's standing in one round — the SINGLE source of truth for the
/// attendee-facing bracket. The participant path reads only `status` (and never
/// the score tables), so a mark cannot leak through it. `roundScore`/`rank` are
/// denormalised per-round aggregates for O(1) reads.
model LeaderboardEntrantRound {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  roundId String           @map("round_id") @db.Uuid
  round   LeaderboardRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  status LeaderboardEntrantRoundStatus @default(PENDING)

  roundScore Decimal? @map("round_score") @db.Decimal(14, 4)
  rank       Int?

  // The curator who last set ADVANCED / ELIMINATED (soft ref to a user).
  decidedBy String?   @map("decided_by") @db.Uuid
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entrantId, roundId])
  @@index([roundId])
  @@map("leaderboard_entrant_rounds")
}

/// A judge/mentor's panel assignment — scopes WHICH rounds/entrants they act on.
/// This is leaderboard-internal and separate from the event-scoped `UserRole`
/// (which grants app access + shows the mobile "Judging" section). A null
/// `roundId`/`entrantId` means "all rounds / all entrants in scope".
/// `userId` is a soft reference (no FK), matching the aggregate convention.
model LeaderboardPanelist {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  userId String                  @map("user_id") @db.Uuid
  kind   LeaderboardPanelistKind

  roundId String?           @map("round_id") @db.Uuid
  round   LeaderboardRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)

  entrantId String?             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant? @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([leaderboardId, userId, roundId, entrantId], map: "leaderboard_panelists_scope_uniq")
  @@index([leaderboardId])
  @@index([userId])
  @@map("leaderboard_panelists")
}

/// The review record for one (panelist, entrant, round): the overall written
/// review plus `submittedAt`, which is the SINGLE source of truth for "has this
/// judge/mentor reviewed them?" on the curator dashboard. Per-criterion comments
/// ride on `LeaderboardScore.comment`; mentors (who leave no scores) carry their
/// comments here in future via a separate path, but v1 keeps comments on scores.
/// `panelistUserId` is a soft reference (no FK).
model LeaderboardJudgment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  roundId String           @map("round_id") @db.Uuid
  round   LeaderboardRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  panelistUserId String                  @map("panelist_user_id") @db.Uuid
  kind           LeaderboardPanelistKind

  overallReview String? @map("overall_review") @db.Text

  // Set on submit → "reviewed" is `submittedAt != null`. On hackathon boards
  // it is stamped on the FIRST submit only, and edits are allowed until
  // max(submittedAt, reopenedAt) + 5 minutes.
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  // Hackathon: the queue slot these marks were given in.
  requestId  String?               @map("request_id") @db.Uuid
  request    HackathonEvalRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  // The curator reopened locked marks for another 5 minutes (soft ref to a user).
  reopenedBy String?               @map("reopened_by") @db.Uuid
  reopenedAt DateTime?             @map("reopened_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entrantId, roundId, panelistUserId])
  @@index([requestId])
  @@index([roundId])
  @@index([panelistUserId])
  @@map("leaderboard_judgments")
}

/// A named award (Winner, Runner-up, Best Design, People's Choice…) declared by
/// a Curator / Space Admin only. Each award has its own `published` flag so
/// winners can be revealed one at a time. Mode-agnostic.
model LeaderboardAward {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  title String @db.VarChar(160)
  order Int    @default(0)

  // Hackathon: why they won, shown with the winner once published.
  notes String? @db.Text

  published Boolean @default(false)

  declaredBy String?   @map("declared_by") @db.Uuid
  declaredAt DateTime? @map("declared_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([leaderboardId, title])
  @@index([leaderboardId])
  @@index([entrantId])
  @@map("leaderboard_awards")
}

/// A room teams are allocated to at a hackathon venue.
model HackathonRoom {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  name             String   @db.VarChar(120)
  // Where it is, e.g. "Block C, 2nd floor".
  location         String?  @db.VarChar(200)
  // How many teams fit. Cancelled teams don't count against it.
  capacity         Int
  notes            String?  @db.Text
  order            Int      @default(0)
  // Event-team members on the floor here (soft refs → users). Teams see them;
  // they get this room's help queries.
  volunteerUserIds String[] @default([]) @map("volunteer_user_ids") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teams LeaderboardEntrant[]

  @@unique([leaderboardId, name])
  @@index([leaderboardId])
  @@map("hackathon_rooms")
}

/// A theme / domain teams work in (e.g. "HealthTech"). Statements can belong to one.
model HackathonTheme {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(60)
  order Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  statements HackathonStatement[]
  teams      LeaderboardEntrant[]

  @@unique([leaderboardId, name])
  @@index([leaderboardId])
  @@map("hackathon_themes")
}

/// A problem statement from the curator's list, which teams pick or are assigned.
model HackathonStatement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  // Short handle shown everywhere, e.g. "PS-03".
  code        String          @db.VarChar(20)
  title       String          @db.VarChar(200)
  description String          @db.Text
  themeId     String?         @map("theme_id") @db.Uuid
  theme       HackathonTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  // How many (non-cancelled) teams may take it. Null = no limit.
  maxTeams    Int?            @map("max_teams")
  order       Int             @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teams LeaderboardEntrant[]

  @@unique([leaderboardId, code])
  @@index([leaderboardId])
  @@index([themeId])
  @@map("hackathon_statements")
}

/// A judge on a hackathon: which themes they judge, where teams find them, and
/// whether they're taking teams. Which rounds they judge stays on
/// LeaderboardPanelist; this row is the hackathon-only extra. `userId` is a soft ref.
model HackathonJudgeProfile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid

  // JUDGE gives marks in evaluation rounds; MENTOR gives feedback in mentoring rounds.
  kind LeaderboardPanelistKind @default(JUDGE)

  // Themes this judge takes (soft refs → hackathon_themes). Empty = any theme.
  themeIds    String[] @map("theme_ids") @db.Uuid
  // A room / table ("Lab 2, table 4"), or a call link for online judging.
  location    String?  @db.VarChar(200)
  meetingUrl  String?  @map("meeting_url") @db.Text
  // Off = on a break: teams can't join their queue, and they can't call next.
  isAvailable Boolean  @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([leaderboardId, userId])
  @@index([userId])
  @@map("hackathon_judge_profiles")
}

/// Judges who sit together for PANEL rounds: one queue, one slot, every member
/// marks. `roundId` null = the panel serves every PANEL round.
model HackathonPanel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  roundId String?           @map("round_id") @db.Uuid
  round   LeaderboardRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  name        String  @db.VarChar(120)
  location    String? @db.VarChar(200)
  meetingUrl  String? @map("meeting_url") @db.Text
  isAvailable Boolean @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members      HackathonPanelMember[]
  evalRequests HackathonEvalRequest[]

  @@unique([leaderboardId, name])
  @@index([leaderboardId])
  @@index([roundId])
  @@map("hackathon_panels")
}

model HackathonPanelMember {
  panelId String         @map("panel_id") @db.Uuid
  panel   HackathonPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  // Soft ref to a user who has a judge profile on the same board.
  userId String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([panelId, userId])
  @@index([userId])
  @@map("hackathon_panel_members")
}

/// A team asking to be evaluated in a round, by one judge (`judgeUserId`) or a
/// panel (`panelId`). Server timestamps drive the slot: `slotEndsAt` =
/// `startedAt` + the round's slotMinutes. One open request per team at a time
/// (partial unique index `hackathon_eval_requests_one_open_per_team`).
model HackathonEvalRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  roundId String           @map("round_id") @db.Uuid
  round   LeaderboardRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  // Exactly one of these: a judge (soft ref to a user) or a panel.
  judgeUserId String?         @map("judge_user_id") @db.Uuid
  panelId     String?         @map("panel_id") @db.Uuid
  panel       HackathonPanel? @relation(fields: [panelId], references: [id], onDelete: SetNull)

  status HackathonEvalStatus @default(WAITING)

  requestedBy  String    @map("requested_by") @db.Uuid
  // Queue order. Moving a team to another judge keeps it, so it keeps its place in time.
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  calledAt     DateTime? @map("called_at") @db.Timestamptz(6)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  slotEndsAt   DateTime? @map("slot_ends_at") @db.Timestamptz(6)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  // Why it closed when it wasn't a normal finish, e.g. REMOVED, ROUND_CLOSED.
  closedReason String?   @map("closed_reason") @db.VarChar(40)
  // Who closed it: the judge, a team member, or the curator (soft ref).
  closedBy     String?   @map("closed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  judgments LeaderboardJudgment[]

  @@index([leaderboardId, status])
  @@index([judgeUserId, status, requestedAt])
  @@index([panelId, status, requestedAt])
  @@index([entrantId, roundId])
  @@index([roundId, status])
  @@map("hackathon_eval_requests")
}

/// A team's project links for a round (repo, demo, deck…), shown to its judges.
model HackathonSubmission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  roundId String           @map("round_id") @db.Uuid
  round   LeaderboardRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // [{ label, url }], https only, at most 10.
  links Json
  notes String? @db.Text

  // The team member who last saved it (soft ref).
  submittedBy String @map("submitted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entrantId, roundId])
  @@index([roundId])
  @@map("hackathon_submissions")
}

/// A message from the organisers, sent as push + in-app to the chosen audience.
model HackathonAnnouncement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  audience HackathonAnnouncementAudience
  // ROOM: the room whose teams it went to (soft ref; the room may be deleted later).
  roomId   String?                       @map("room_id") @db.Uuid
  roomName String?                       @map("room_name") @db.VarChar(120)

  title String @db.VarChar(120)
  body  String @db.Text

  // How many people it was sent to.
  recipients Int @default(0)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([leaderboardId, createdAt])
  @@map("hackathon_announcements")
}

// =====================================================
// CERTIFICATE MODELS
// Organiser-designed certificate templates + issued,
// publicly-verifiable certificates for attendees.
// =====================================================

/// A reusable certificate layout for one event: an uploaded background image
/// plus a set of positioned text fields. `fields` stores placement DATA, not
/// code, so organisers reposition text without a deploy. The background is
/// designed against a fixed canvas (`canvasWidth` x `canvasHeight`, in px); at
/// render time every field's coordinates are interpreted in that same space and
/// scaled to the output.
model CertificateTemplate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name String @db.VarChar(150)

  // Uploaded design the text is composited over. Should already contain all
  // static artwork (logos, borders, signatures). Aspect ratio is free but
  // landscape A4 (e.g. 2000x1414) is the sensible default.
  backgroundUrl String @map("background_url") @db.Text

  // The canvas the `fields` coordinates are authored against. Kept explicit so
  // the renderer never has to guess the design's intended dimensions.
  canvasWidth  Int @map("canvas_width")
  canvasHeight Int @map("canvas_height")

  // Array of CertificateField placements. Each element:
  //   {
  //     key: "recipientName" | "eventTitle" | "issueDate"
  //          | "certificateNumber" | "custom",
  //     label?: string,            // for a "custom" field, the static text
  //     x: number, y: number,      // top-left of the text box, in canvas px
  //     fontSize: number,          // in canvas px
  //     color: string,             // hex, e.g. "#1a1a1a"
  //     align: "left" | "center" | "right",
  //     bold?: boolean,
  //     italic?: boolean,
  //     maxWidth?: number          // wrap/shrink box width in canvas px
  //   }
  fields Json

  createdBy String @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Retired (B19): hidden and no longer issuable, kept because certificates
  /// were issued from it and their verify links must keep working.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  certificates Certificate[]

  @@index([eventId])
  @@map("certificate_templates")
}

/// One issued certificate for one recipient. Immutable once created except for
/// revocation. `recipientName` is snapshotted so a later profile rename never
/// rewrites history. `verificationCode` is the public, unguessable handle used
/// by the verify page; `certificateNumber` is the human-readable serial shown
/// on the certificate itself.
model Certificate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  templateId String              @map("template_id") @db.Uuid
  template   CertificateTemplate @relation(fields: [templateId], references: [id])

  // The recipient's account, when known. Null is allowed for a manually issued
  // certificate to someone without a Unifesto account (e.g. an external judge).
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("CertificateRecipient", fields: [userId], references: [id], onDelete: SetNull)

  // The registration this certificate was earned through, when applicable.
  // SetNull so cancelling/removing a registration never destroys the record of
  // a certificate that was legitimately earned.
  registrationId String?            @map("registration_id") @db.Uuid
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  // For a GROUP registration (one row, many people in GroupSeat rows), this is
  // the member's index (seat index - 1) — so every teammate gets their own
  // certificate off the one shared registration. Null / 0 for an individual.
  memberIndex Int? @map("member_index")

  // Snapshots — frozen at issue time, never re-derived. `recipientName` comes
  // from the registration's form responses / group-member data, NOT the
  // account (many accounts have no name set).
  recipientName  String  @map("recipient_name") @db.VarChar(255)
  recipientEmail String? @map("recipient_email") @db.VarChar(255)

  // How this recipient qualified (drives nothing at render; kept for audit).
  audience CertificateAudience

  // Hackathon winner certificate: the award it's for (soft ref → leaderboard_awards),
  // which fills {awardTitle}. Part of the dedup key, so a team with two awards
  // gets one certificate per award from the same template.
  awardId String? @map("award_id") @db.Uuid

  certificateNumber String @unique @map("certificate_number") @db.VarChar(100)
  verificationCode  String @unique @map("verification_code") @db.VarChar(64)

  // Rendered artifacts in S3. Null only in the brief window between row creation
  // and the render finishing; a fully issued certificate has both.
  pdfUrl   String? @map("pdf_url") @db.Text
  imageUrl String? @map("image_url") @db.Text

  status CertificateStatus @default(ISSUED)

  issuedBy String   @map("issued_by") @db.Uuid
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.Text
  /// Revoked one at a time, for a reason (B19): batch re-runs and "Reissue
  /// all" leave it revoked. A bulk "Revoke all" (redesign) leaves this false.
  revokedForCause Boolean @default(false) @map("revoked_for_cause")

  // When the recipient was last emailed a link to this certificate. Null means
  // never delivered (no email on file, or a send that failed) — so this doubles
  // as the "needs a resend" signal. Re-stamped on each successful send.
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(6)

  // Dedup key is (template, registration, memberIndex) — a group's members
  // share one registration + one account (the lead's), so keying on userId
  // would collapse a whole team into a single certificate. Enforced in the
  // issue() flow; the DB keeps a supporting index rather than a unique that
  // NULLs would silently weaken.
  @@index([templateId])
  @@index([eventId])
  @@index([userId])
  @@index([verificationCode])
  @@index([status])
  @@map("certificates")
}

/// One queued certificate-issuance run. Issuance renders a PDF + PNG per
/// recipient with @napi-rs/canvas (Skia), whose buffers live in NATIVE memory
/// outside the V8 heap — a large batch done inline in the request pushed replica
/// RSS past its cap and got OOM-killed. So issuance is enqueued onto a BullMQ
/// queue and processed by a concurrency-bounded worker; this row is the batch's
/// durable record, letting the organiser poll progress and surviving a restart
/// (the job re-runs and is idempotent). `registrationIds` is only set for the
/// MANUAL audience. Counts mirror the summary the worker produces.
model CertificateBatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Plain scalars (no FK relations) so this history survives event/template
  // deletion and needs no back-relations on those large models.
  eventId    String @map("event_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid

  audience CertificateAudience

  // Hand-picked registrations for the MANUAL audience; empty otherwise.
  registrationIds String[] @map("registration_ids") @db.Uuid

  // Hackathon winners batch: the award these certificates are for (soft ref).
  awardId String? @map("award_id") @db.Uuid

  status CertificateBatchStatus @default(QUEUED)

  total       Int @default(0)
  issued      Int @default(0)
  reactivated Int @default(0)
  skipped     Int @default(0)
  failed      Int @default(0)

  error String? @db.Text

  requestedBy String    @map("requested_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([eventId])
  @@index([status])
  @@map("certificate_batches")
}

/// One generated event report. A report is a snapshot: `stats` and the rendered
/// PDF freeze the numbers at generation time, so re-downloading an old report
/// never silently changes as new registrations arrive. Generate again for fresh
/// figures. Organiser-only, gated by the space plan's `hasAnalytics`.
model EventReport {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type   ReportType   @default(DEFAULT)
  status ReportStatus @default(PENDING)

  // Shown in the history list; defaults to "<Event title> — <date>".
  title String @db.VarChar(200)

  // Sections baked into this report. DEFAULT reports carry every section; CUSTOM
  // reports carry the organiser's chosen subset. Stored per report so a
  // re-download reflects the file as built, independent of today's defaults.
  sections ReportSection[]

  // Optional reporting window applied to time-bounded sections (registrations,
  // check-ins). Null bounds mean "the event's whole lifetime".
  dateFrom DateTime? @map("date_from") @db.Timestamptz(6)
  dateTo   DateTime? @map("date_to") @db.Timestamptz(6)

  // Snapshot of the headline KPIs at generation time so the history list can
  // show figures without reopening the PDF. Shape mirrors ReportOverview.
  stats Json?

  // The generated PDF in S3. Null until `status` flips to READY.
  fileUrl  String? @map("file_url") @db.Text
  fileName String? @map("file_name") @db.VarChar(255)

  // Why a FAILED generation failed (surfaced to the organiser, never silent).
  error String? @db.Text

  // M3: AI-written summary of an ended event, from the same snapshot as the
  // PDF (which prints it on top). Null when the event hadn't ended, the
  // feature is off, or the model refused or failed.
  aiSummary   String?   @map("ai_summary") @db.Text
  aiSummaryAt DateTime? @map("ai_summary_at") @db.Timestamptz(6)

  generatedBy String @map("generated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([eventId])
  @@index([status])
  @@map("event_reports")
}

// =====================================================
// SPONSORS & LEAD GENERATION
// A reusable, space-level sponsor roster that attaches to any number of events
// (with per-event overrides), plus two lead streams: attendee -> sponsor
// (SponsorLead) and the organiser's own funnel (Lead). Gated by
// PlanConfig.hasSponsors. Sponsor people sign in through the space app's sponsor
// portal; their access is carried by SponsorUser, not the space/event role
// matrix (sponsor access is scoped to a Sponsor entity, which the matrix cannot
// express — the same reason JUDGE is scoped to its events, not the matrix).
// =====================================================

enum SponsorUserStatus {
  /// Invited to the portal; has not accepted / first-logged-in yet.
  INVITED
  /// Active portal member.
  ACTIVE
  /// Access revoked; row kept for audit.
  REVOKED

  @@map("sponsor_user_status")
}

enum SponsorLeadSource {
  /// Attendee deliberately tapped "I'm interested" on this sponsor.
  OPT_IN
  /// Sponsor/crew scanned the attendee's ticket QR at a booth (scan = consent).
  BOOTH_SCAN
  /// Captured by a sponsor by hand (walk-up, business card).
  MANUAL
  /// Imported in bulk by the organiser.
  IMPORT

  @@map("sponsor_lead_source")
}

enum LeadSource {
  /// "Notify me" / "Interested" on an event before registering.
  EVENT_INTEREST
  /// Inquiry form on the public space page.
  SPACE_INQUIRY
  /// Manually added by the organiser.
  MANUAL
  /// Imported in bulk.
  IMPORT

  @@map("lead_source")
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED

  @@map("lead_status")
}

/// A rung on a space's sponsorship ladder (Platinum, Gold, ...). Sponsors are
/// grouped and ordered by their tier's `rank` on public pages. Space-level so a
/// space defines its ladder once and reuses it across events.
model SponsorTier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name  String  @db.VarChar(100)
  /// Display order across tiers; 0 is the most prominent (e.g. Platinum) tier.
  rank  Int     @default(0)
  /// Optional accent colour (hex) for the tier badge on public pages.
  color String? @db.VarChar(9)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  eventSponsors EventSponsor[]

  @@index([spaceId])
  @@map("sponsor_tiers")
}

/// A sponsor in a space's reusable roster. Entered once, attached to many events
/// via EventSponsor. Deleting a space cascades its sponsors away.
model Sponsor {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  logoUrl     String? @map("logo_url") @db.Text
  websiteUrl  String? @map("website_url") @db.Text
  description String? @db.Text

  // Default point of contact for the sponsor.
  contactName  String? @map("contact_name") @db.VarChar(255)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  eventSponsors EventSponsor[]
  sponsorUsers  SponsorUser[]

  @@index([spaceId])
  @@map("sponsors")
}

/// Attaches a roster Sponsor to one Event, carrying per-event overrides: the
/// tier it sits in *for this event*, its placement, whether it captures leads
/// here, and optional logo/description overrides (null = inherit the Sponsor's).
model EventSponsor {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sponsorId String  @map("sponsor_id") @db.Uuid
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  // Per-event tier. SetNull so removing a tier from the ladder leaves the
  // sponsor attached (untiered) rather than detaching it from the event.
  tierId String?      @map("tier_id") @db.Uuid
  tier   SponsorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  /// Placement within the tier; lower shows first.
  order Int @default(0)

  /// Whether attendees can generate leads for this sponsor at this event
  /// (opt-in button + booth scan). Off by default: sponsorship *display* is
  /// separate from lead *capture*, which the organiser turns on deliberately.
  leadCaptureEnabled Boolean @default(false) @map("lead_capture_enabled")

  // Per-event overrides. Null = fall back to the roster Sponsor's own value.
  overrideLogoUrl     String? @map("override_logo_url") @db.Text
  overrideDescription String? @map("override_description") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads SponsorLead[]

  // A sponsor attaches to a given event at most once.
  @@unique([eventId, sponsorId])
  @@index([eventId])
  @@index([sponsorId])
  @@index([tierId])
  @@map("event_sponsors")
}

/// Links a User account to a Sponsor for portal access — the source of truth for
/// "which people can act as this sponsor".
model SponsorUser {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sponsorId String  @map("sponsor_id") @db.Uuid
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("SponsorUserAccount", fields: [userId], references: [id], onDelete: Cascade)

  status SponsorUserStatus @default(INVITED)

  // The email the invite was sent to (may precede the account existing).
  invitedEmail String? @map("invited_email") @db.VarChar(255)
  invitedBy    String? @map("invited_by") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  @@unique([sponsorId, userId])
  @@index([sponsorId])
  @@index([userId])
  @@map("sponsor_users")
}

/// A lead captured *for a sponsor* at an event: an attendee who opted in, was
/// scanned at the booth, or was added by hand. Contact fields are snapshotted so
/// the lead survives the attendee editing/deleting their profile, and so
/// booth/manual capture works without an account.
model SponsorLead {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventSponsorId String       @map("event_sponsor_id") @db.Uuid
  eventSponsor   EventSponsor @relation(fields: [eventSponsorId], references: [id], onDelete: Cascade)

  // The attendee behind the lead, when known. SetNull keeps the snapshot lead
  // if the registration is deleted.
  registrationId String?            @map("registration_id") @db.Uuid
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  // Contact snapshot.
  name  String? @db.VarChar(255)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(50)

  source SponsorLeadSource @default(OPT_IN)
  note   String?           @db.Text

  // Who captured it (crew/sponsor user id) for booth/manual sources.
  capturedBy String? @map("captured_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // One opt-in/scan per (sponsor-at-event, attendee). Manual leads without a
  // registration are exempt: Postgres does not enforce a unique tuple that
  // contains a NULL, so multiple registration-less leads coexist.
  @@unique([eventSponsorId, registrationId])
  @@index([eventSponsorId])
  @@index([registrationId])
  @@map("sponsor_leads")
}

/// The organiser's own lead funnel — people who signalled interest but have not
/// (or not yet) registered: "Notify me" on an event, an inquiry on the space
/// page, a manual add or import. Space-owned; optionally tied to an event.
model Lead {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // The event the interest was about, when the lead came from an event surface.
  // SetNull so deleting the event keeps the lead in the space funnel.
  eventId String? @map("event_id") @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  name    String? @db.VarChar(255)
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)
  message String? @db.Text

  source LeadSource @default(EVENT_INTEREST)
  status LeadStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@index([eventId])
  @@index([status])
  @@map("leads")
}

// =====================================================
// CAREERS
// Public job postings for the marketing site (web). Applications are handled
// off-platform via email (mailto), so no applicant records are stored.
// =====================================================

enum CareerStatus {
  /// Visible on the public careers page.
  OPEN
  /// Kept but hidden from the public (filled / paused).
  CLOSED
  /// Work-in-progress, never public.
  DRAFT

  @@map("career_status")
}

model Career {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title           String @db.VarChar(255)
  department      String @db.VarChar(120)
  location        String @db.VarChar(160)
  /// Employment type, e.g. Full-time / Part-time / Contract / Internship.
  type            String @db.VarChar(60)
  experienceLevel String @map("experience_level") @db.VarChar(80)

  description      String   @db.Text
  requirements     String[]
  responsibilities String[]
  benefits         String[]

  salaryRange String? @map("salary_range") @db.VarChar(120)

  status CareerStatus @default(DRAFT)

  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications CareerApplication[]

  @@index([status])
  @@map("careers")
}

/// Applicant-tracking status for one submitted application.
enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED

  @@map("application_status")
}

/// An in-platform job application submitted through the public careers page,
/// including an uploaded resume. Cascade-deleted with its role.
model CareerApplication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  careerId String @map("career_id") @db.Uuid
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  fullName String  @map("full_name") @db.VarChar(255)
  email    String  @db.VarChar(255)
  phone    String? @db.VarChar(40)

  /// S3 URL of the uploaded resume (unguessable key).
  resumeUrl   String  @map("resume_url") @db.Text
  coverLetter String? @map("cover_letter") @db.Text

  linkedinUrl  String? @map("linkedin_url") @db.Text
  portfolioUrl String? @map("portfolio_url") @db.Text

  status ApplicationStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([careerId])
  @@index([status])
  @@map("career_applications")
}

// =====================================================
// BLOG
// Marketing blog for the public site (web). Authored by admins in apex.
// Content is Markdown, rendered on the web.
// =====================================================

enum BlogStatus {
  /// Work-in-progress, never public.
  DRAFT
  /// Live on the public blog.
  PUBLISHED

  @@map("blog_status")
}

model BlogPost {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug    String @unique @db.VarChar(220)
  title   String @db.VarChar(255)
  excerpt String @db.Text
  /// Article body, in Markdown.
  content String @db.Text

  category      String  @db.VarChar(80)
  author        String  @db.VarChar(120)
  coverImageUrl String? @map("cover_image_url") @db.Text
  /// Estimated read time in minutes.
  readMinutes   Int?    @map("read_minutes")

  featured Boolean    @default(false)
  status   BlogStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([slug])
  @@index([category])
  @@map("blog_posts")
}

// =====================================================
// Help articles (D17): the Assist knowledge base
// =====================================================

enum HelpArticleStatus {
  /// Work-in-progress, never public.
  DRAFT
  /// Live on unifesto.app/help and readable by the Assist bot.
  PUBLISHED

  @@map("help_article_status")
}

model HelpArticle {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug     String            @unique @db.VarChar(220)
  title    String            @db.VarChar(255)
  /// Article body, in Markdown.
  body     String            @db.Text
  category String            @db.VarChar(80)
  status   HelpArticleStatus @default(DRAFT)

  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, category])
  @@map("help_articles")
}

// =====================================================
// Push notifications platform (OneSignal)
// =====================================================

enum PushScope {
  PLATFORM // admin broadcast to a user segment
  EVENT // organiser announcement to an event's attendees

  @@map("push_scope")
}

enum PushCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED

  @@map("push_campaign_status")
}

enum PushLogStatus {
  SENT
  FAILED
  SKIPPED_PREF // recipient opted out of the category (or push globally)

  @@map("push_log_status")
}

model PushCampaign {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  scope   PushScope
  eventId String?   @map("event_id") @db.Uuid // set for organiser/event-scoped

  // Admin or organiser who created it (plain uuid, mirrors AdminDevice — no FK back-ref).
  createdById String @map("created_by_id") @db.Uuid

  title String @db.VarChar(255)
  body  String @db.Text
  data  Json? // deepLink etc.

  // Which NotificationCategory this broadcast sends under — drives pref opt-out.
  // Admin-selectable ('promotions' opt-in vs 'productUpdates' opt-out); EVENT
  // scope always sends as 'organiserAnnouncements' regardless of this value.
  category String @default("promotions") @map("category") @db.VarChar(64)

  // all | eventId | tag | pref-filter — mirrors EmailCampaign.segmentFilters.
  targetSegment Json @map("target_segment")

  status      PushCampaignStatus @default(DRAFT)
  scheduledAt DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime?          @map("sent_at") @db.Timestamptz(6)

  sentCount   Int @default(0) @map("sent_count")
  failedCount Int @default(0) @map("failed_count")
  // Segment broadcasts only: OneSignal's notification id. Its create response
  // carries no recipient count, so sent/failed are read back from its stats.
  oneSignalId String? @map("onesignal_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  logs PushLog[]

  @@index([status])
  @@index([scope])
  @@index([eventId])
  @@index([createdById])
  @@map("push_campaigns")
}

model PushLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  campaignId String?       @map("campaign_id") @db.Uuid // null for transactional
  campaign   PushCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId   String @map("user_id") @db.Uuid
  category String @db.VarChar(64)

  status      PushLogStatus
  oneSignalId String?       @map("one_signal_id") @db.VarChar(255)
  error       String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Idempotency for campaign fan-out: one row per (campaign, user).
  @@unique([campaignId, userId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt]) // retention sweep (RetentionService)
  @@map("push_logs")
}

enum MessageChannel {
  PUSH
  EMAIL
  WHATSAPP

  @@map("message_channel")
}

enum MessageDeliveryStatus {
  QUEUED // claimed (dedupKey row written before the send), not finished yet
  SENT // the provider accepted it
  DELIVERED // provider webhook confirmed delivery (C5)
  OPENED // provider webhook: opened / read (C5)
  FAILED
  SKIPPED // not sent: the user's preferences said no
  SUPPRESSED // not sent: bounced/complained address or provider suppression (C5)

  @@map("message_delivery_status")
}

// One row per outbound message on every channel (C3), written at the transport
// layer (EmailService.deliver, WhatsAppService.sendTemplateMessage,
// NotificationsService.send), so every send is logged without touching call
// sites. Push still writes PushLog too (campaign idempotency lives there).
model MessageDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  channel  MessageChannel
  provider String         @db.VarChar(20) // resend | ses | meta | onesignal
  kind     String?        @db.VarChar(64) // notify kind or push category
  label    String         @db.VarChar(255) // email subject / WhatsApp template / push title
  // Email address, E.164-ish phone, or (push) the user id / segment name.
  recipient String  @db.VarChar(320)
  userId    String? @map("user_id") @db.Uuid

  status            MessageDeliveryStatus
  providerMessageId String?               @map("provider_message_id") @db.VarChar(255)
  error             String?               @db.Text
  attempts          Int                   @default(0)
  // Optional idempotency key: a second send with the same key is skipped once
  // the first is SENT/DELIVERED/OPENED, retried when it FAILED.
  dedupKey String? @unique @map("dedup_key") @db.VarChar(255)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)]) // per-user history (C6)
  @@index([recipient, createdAt(sort: Desc)])
  @@index([providerMessageId]) // provider webhooks update by it (C5)
  @@index([status, createdAt]) // failure dashboard (C6)
  @@index([createdAt]) // retention sweep (RetentionService)
  @@map("message_deliveries")
}

enum EmailSuppressionReason {
  BOUNCE // permanent (hard) bounce
  COMPLAINT // the recipient marked it as spam
  MANUAL // added by a platform admin

  @@map("email_suppression_reason")
}

// C5: addresses we never mail again (except sign-in codes). Written by the SES
// and Resend webhooks; an admin can remove one from Apex.
model EmailSuppression {
  id      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address String                 @unique @db.VarChar(320) // lowercased
  reason  EmailSuppressionReason
  source  String                 @db.VarChar(20) // ses | resend | admin
  details String?                @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("email_suppressions")
}

// One row per app install that can receive push. `subscriptionId` is OneSignal's
// push subscription id (the device id); it moves to whichever user last signed
// in on that device. `linkedAt` = server confirmed OneSignal external_id = userId.
model UserPushDevice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String  @unique @map("subscription_id") @db.VarChar(64)
  oneSignalId    String? @map("one_signal_id") @db.VarChar(64)
  platform       String  @db.VarChar(10)
  deviceModel    String? @map("device_model") @db.VarChar(120)
  appVersion     String? @map("app_version") @db.VarChar(20)
  optedIn        Boolean @default(false) @map("opted_in")

  linkedAt   DateTime? @map("linked_at") @db.Timestamptz(6)
  linkError  String?   @map("link_error") @db.Text
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("user_push_devices")
}

// =====================================================
// WHATSAPP INBOX
// Two-way conversations on the WhatsApp Business (Cloud API) number.
//
// Inbound messages arrive via the Meta webhook (WhatsAppController) and are
// persisted here so platform admins can read and reply to them from Apex.
// Outbound rows are the admin's free-form replies (sent inside Meta's 24h
// customer-service window) plus, optionally, delivery-status updates.
// =====================================================

enum WhatsappMessageDirection {
  INBOUND // from the customer to our number
  OUTBOUND // an admin reply from Apex

  @@map("whatsapp_message_direction")
}

model WhatsappConversation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The customer's WhatsApp id (Meta's `wa_id`) — digits only, e.g. 919876543210.
  // One conversation per number; the number is the natural key.
  waId String @unique @map("wa_id") @db.VarChar(20)

  // Display name Meta supplies with inbound messages (contacts[].profile.name).
  profileName String? @map("profile_name") @db.VarChar(255)

  // If the number matches a known account we link it (best-effort, nullable).
  userId String? @map("user_id") @db.Uuid

  // Timestamp of the most recent INBOUND message. Drives the 24h customer-service
  // window inside which free-form (non-template) replies are permitted.
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamptz(6)

  // Most recent message either direction — the inbox sort key.
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)

  // Unread inbound count for the inbox badge; reset to 0 when an admin opens it.
  unreadCount Int @default(0) @map("unread_count")

  // D26: the Assist case this conversation was converted to (soft ref → support_tickets).
  caseId String? @map("case_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages WhatsappMessage[]

  @@index([lastMessageAt])
  @@index([userId])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  conversationId String               @map("conversation_id") @db.Uuid
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction WhatsappMessageDirection

  // Meta's message id (`wamid...`). Unique so webhook retries can't duplicate a
  // row. Null only for records we somehow persist before the API returns an id.
  waMessageId String? @unique @map("wa_message_id") @db.VarChar(128)

  // Message kind from Meta ('text', 'image', 'document', 'audio', ...). Outbound
  // replies are always 'text'.
  type String @default("text") @db.VarChar(32)

  // Text body (or caption). Null for media with no caption.
  body String? @db.Text

  // For non-text inbound, a short note about the attachment (kind / mime).
  mediaNote String? @map("media_note") @db.Text

  // For image/sticker inbound, the S3 URL the bytes were copied to (Meta's own
  // media URL is short-lived and needs the access token, so it can't be embedded
  // directly). Null until the copy succeeds; render falls back to mediaNote.
  mediaUrl String? @map("media_url") @db.Text

  // OUTBOUND only: the admin who sent the reply (plain uuid, mirrors
  // PushCampaign.createdById — no FK back-ref onto the large User model).
  sentById String? @map("sent_by_id") @db.Uuid

  // OUTBOUND delivery lifecycle from status webhooks: 'sent' | 'delivered' |
  // 'read' | 'failed'. Null for inbound.
  status String? @db.VarChar(32)

  // Populated when a send/delivery fails (Meta error title or our own reason).
  errorText String? @map("error_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt])
  @@index([createdAt]) // retention sweep (RetentionService)
  @@map("whatsapp_messages")
}

/// Audit trail for Apex WhatsApp template blasts: who sent which template to
/// which audience, when, and how many went out. Plain uuids, no FKs.
model WhatsappBroadcast {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sentById     String   @map("sent_by_id") @db.Uuid
  templateName String   @map("template_name") @db.VarChar(512)
  languageCode String   @map("language_code") @db.VarChar(10)
  // Meta template category (MARKETING / UTILITY / AUTHENTICATION), UNKNOWN when
  // the lookup failed (then it was treated as marketing).
  category     String   @db.VarChar(20)
  audience     String   @db.VarChar(10) // ALL | SPACE | USER
  spaceId      String?  @map("space_id") @db.Uuid
  userIds      String[] @map("user_ids") @db.Uuid
  bodyParams   String[] @map("body_params")
  isTest       Boolean  @default(false) @map("is_test")

  recipientCount Int @map("recipient_count")
  sentCount      Int @default(0) @map("sent_count")
  failedCount    Int @default(0) @map("failed_count")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("whatsapp_broadcasts")
}

/// What a content report points at. Polymorphic (no FK): the target is looked
/// up by type + id, and a report outlives a deleted target for the audit trail.
enum ContentReportTarget {
  EVENT
  SPACE
  REGISTRATION // "Report an issue" on a ticket

  @@map("content_report_target")
}

enum ContentReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED

  @@map("content_report_status")
}

/// A user's report about an event, a space, or one of their tickets. Reviewed
/// by platform admins. One open report per reporter + target (re-reporting
/// updates it rather than stacking duplicates).
model ContentReport {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  reporterId String @map("reporter_id") @db.Uuid
  reporter   User   @relation("ContentReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ContentReportTarget @map("target_type")
  targetId   String              @map("target_id") @db.Uuid

  /// Machine key from the per-type reason list (validated in the service).
  reason  String  @db.VarChar(40)
  details String? @db.Text

  status         ContentReportStatus @default(OPEN)
  resolutionNote String?             @map("resolution_note") @db.Text
  resolvedById   String?             @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([reporterId])
  @@map("content_reports")
}

/// A partner (club, community, sponsor) a curator hands a tracking link to.
/// Registrations tagged utm_source=<source>&utm_medium=partner are credited to
/// it. `partnerUser` is the partner's contact on Unifesto: they see this
/// partner's registration counts for this event in the app, never attendee
/// details or revenue. Revoking hides the stats from them; the tracking link
/// keeps attributing (the tags live on the registrations).
model EventPartnerLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name   String @db.VarChar(80)
  // Slugified name, used as utm_source. Unique per event.
  source String @db.VarChar(60)

  partnerUserId String @map("partner_user_id") @db.Uuid
  partnerUser   User   @relation("PartnerLinkContact", fields: [partnerUserId], references: [id], onDelete: Cascade)

  createdById String?   @map("created_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([eventId, source])
  @@index([partnerUserId])
  @@map("event_partner_links")
}

// =====================================================
// TRAFFIC
// Page views and tracked short links
// =====================================================

/// What a page view or short link points at. URL is short links only.
enum SlugKind {
  EVENT
  SPACE

  @@map("slug_kind")
}

/// A slug an event or space used to have. Lookups by slug fall back here so
/// shared links and printed QR codes survive a rename; a live slug always wins
/// (a new owner of the slug is never redirected away). No FK: the target is an
/// event or a space; a deleted target just 404s as before.
model SlugHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      SlugKind
  slug      String   @db.VarChar(200)
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, slug])
  @@map("slug_history")
}

enum TrafficTarget {
  EVENT
  SPACE
  URL
}

/// One view of an event or space page. `visitorId` is an anonymous id per app
/// install, so "visitors" counts devices, not people; no user id is stored.
/// Event views also carry the host space, so space totals include its events.
/// Repeat views from one visitor within 30 minutes are dropped at ingest.
model PageView {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  target  TrafficTarget
  eventId String?       @map("event_id") @db.Uuid
  event   Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  spaceId String        @map("space_id") @db.Uuid
  space   Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  visitorId String  @map("visitor_id") @db.VarChar(64)
  // ios | android | web
  platform  String  @db.VarChar(16)
  // utm tags of the link that opened the page, when there was one.
  source    String? @db.VarChar(100)
  medium    String? @db.VarChar(100)
  campaign  String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId, createdAt])
  @@index([spaceId, createdAt])
  @@index([createdAt])
  @@map("page_views")
}

/// A tracked short link, served by the API at /l/<code>. `url` is the full
/// destination with utm_medium=short_link&utm_campaign=<code> already on it,
/// so registrations it brings in are credited through event_registrations.utm_*.
/// Event links also carry the host space so the space lists them.
model ShortLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code    String        @unique @db.VarChar(16)
  target  TrafficTarget
  eventId String?       @map("event_id") @db.Uuid
  event   Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  spaceId String?       @map("space_id") @db.Uuid
  space   Space?        @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  url    String  @db.Text
  title  String? @db.VarChar(120)
  // utm_source on the destination ("instagram", "poster"...). Defaults to "link".
  source String  @default("link") @db.VarChar(60)

  clickCount  Int       @default(0) @map("click_count")
  createdById String?   @map("created_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  clicks ShortLinkClick[]

  @@index([spaceId])
  @@index([eventId])
  @@map("short_links")
}

/// One click on a short link. `visitorHash` is an HMAC of IP + user agent (the
/// raw IP is never stored); link-preview bots are not recorded.
model ShortLinkClick {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  shortLinkId String    @map("short_link_id") @db.Uuid
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  visitorHash    String  @map("visitor_hash") @db.VarChar(64)
  // Host of the Referer header, e.g. "instagram.com"; null when direct.
  referrerDomain String? @map("referrer_domain") @db.VarChar(255)
  // ios | android | desktop
  device         String  @db.VarChar(16)
  // ISO 3166-1 alpha-2 from Cloudflare's Cf-Ipcountry, e.g. "IN"; null when unknown.
  country        String? @db.VarChar(2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shortLinkId, createdAt])
  @@index([createdAt]) // retention sweep (RetentionService)
  @@map("short_link_clicks")
}

// =====================================================
// DEFAULT IMAGES
// Stand-in banners and logos for events / spaces without their own
// =====================================================

enum DefaultImageKind {
  BANNER
  LOGO
}

/// A stand-in image managed in Apex. Apps show one for an event without a
/// cover (BANNER, 4:3) or a space without a logo (LOGO, 1:1), picked by a
/// stable hash of the event/space id so the same page always gets the same one.
model DefaultImage {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        DefaultImageKind
  url         String           @db.Text
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kind, createdAt])
  @@map("default_images")
}

// =====================================================
// UNIFESTO STAY — accommodation attached to an event
// =====================================================
// The event team lists where attendees can stay (a Stay = one property) and
// what can be booked there (StayOption = a pool of beds: "Boys dorm bed",
// "Twin room bed"). A registered attendee requests beds for a range of nights;
// the team approves, the attendee pays if the option is paid online, and a
// Stay Pass (QR) is issued that the team scans at check-in.
//
// Capacity is counted per bed per night: an option with 40 beds can hold 40
// guests on any one night. A booking of 3 guests from the 10th to the 12th
// holds 3 beds on the nights of the 10th and 11th (check-out day is free).

enum StayPropertyType {
  HOSTEL
  HOTEL
  DORMITORY
  GUEST_HOUSE
  HOMESTAY
  OTHER

  @@map("stay_property_type")
}

/// Who an option is for. ANY = mixed / not restricted.
enum StayGender {
  ANY
  MALE
  FEMALE

  @@map("stay_gender")
}

/// How the guest pays for an option. FREE when the price is 0.
///   PAY_AT_PROPERTY: the team collects offline and marks the booking paid.
///   ONLINE:          paid in the app through Razorpay after approval; counts
///                    towards the event's payout like ticket money.
enum StayPaymentMode {
  FREE
  PAY_AT_PROPERTY
  ONLINE

  @@map("stay_payment_mode")
}

enum StayPricing {
  PER_NIGHT // price x guests x nights
  PER_STAY // price x guests, whatever the nights

  @@map("stay_pricing")
}

/// Booking lifecycle.
///   PENDING -> (team approves) -> AWAITING_PAYMENT (ONLINE only) -> CONFIRMED
///   PENDING -> (team approves, not ONLINE) -> CONFIRMED
///   CONFIRMED -> CHECKED_IN -> CHECKED_OUT
///   PENDING -> REJECTED;  any open state -> CANCELLED
///   AWAITING_PAYMENT past paymentDueAt -> EXPIRED (beds released)
/// Beds are held from AWAITING_PAYMENT onwards (HOLDS_BEDS in the service); a
/// PENDING request holds nothing, so approval re-checks availability.
enum StayBookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  REJECTED
  CANCELLED
  EXPIRED

  @@map("stay_booking_status")
}

/// One property the event team offers.
model Stay {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String           @db.VarChar(200)
  propertyType  StayPropertyType @default(HOSTEL) @map("property_type")
  description   String?          @db.Text
  coverImageUrl String?          @map("cover_image_url") @db.Text
  // Extra photos (rooms, washrooms, common areas), shown after the cover.
  galleryUrls   String[]         @default([]) @map("gallery_urls")
  address       String?          @db.Text
  city          String?          @db.VarChar(100)
  mapUrl        String?          @map("map_url") @db.Text
  amenities     String[]
  houseRules    String?          @map("house_rules") @db.Text
  contactName   String?          @map("contact_name") @db.VarChar(120)
  contactPhone  String?          @map("contact_phone") @db.VarChar(20)

  // Bookable window: guests may check in from `checkInFrom` and must be out by
  // `checkOutUntil` (calendar dates).
  checkInFrom   DateTime @map("check_in_from") @db.Date
  checkOutUntil DateTime @map("check_out_until") @db.Date
  // Shown on the pass, e.g. "12:00 PM" / "10:00 AM".
  checkInTime   String?  @map("check_in_time") @db.VarChar(20)
  checkOutTime  String?  @map("check_out_time") @db.VarChar(20)

  // Every guest must upload a photo ID with the request.
  requireIdProof     Boolean @default(true) @map("require_id_proof")
  // ONLINE options: how long an approved guest has to pay before the beds are
  // released back.
  paymentWindowHours Int     @default(48) @map("payment_window_hours")
  // Hidden from attendees until the team publishes it.
  isPublished        Boolean @default(false) @map("is_published")
  order              Int     @default(0)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  options   StayOption[]
  questions StayQuestion[]
  bookings  StayBooking[]

  @@index([eventId])
  @@map("stays")
}

/// What can be booked at a Stay: a pool of beds with one price.
model StayOption {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  stayId String @map("stay_id") @db.Uuid
  stay   Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)

  name        String          @db.VarChar(120)
  description String?         @db.Text
  gender      StayGender      @default(ANY)
  totalBeds   Int             @map("total_beds")
  price       Decimal         @default(0) @db.Decimal(10, 2)
  pricing     StayPricing     @default(PER_NIGHT)
  paymentMode StayPaymentMode @default(FREE) @map("payment_mode")
  // Largest group one request may book (the booker counts as one).
  maxGuests   Int             @default(1) @map("max_guests")
  isActive    Boolean         @default(true) @map("is_active")
  order       Int             @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings StayBooking[]

  @@index([stayId])
  @@map("stay_options")
}

/// A custom question the team asks on every booking request at a Stay. Same
/// shape and rules as EventFormField (registrations/form-answers.util.ts), so
/// answers are validated by the same code. Asked once per booking.
model StayQuestion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  stayId String @map("stay_id") @db.Uuid
  stay   Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)

  label      String        @db.VarChar(255)
  type       FormFieldType
  options    String[]
  isRequired Boolean       @default(false) @map("is_required")
  order      Int           @default(0)
  helpText   String?       @map("help_text") @db.VarChar(500)
  config     Json?
  showIf     Json?         @map("show_if")

  @@index([stayId])
  @@map("stay_questions")
}

model StayBooking {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  stayId   String     @map("stay_id") @db.Uuid
  stay     Stay       @relation(fields: [stayId], references: [id], onDelete: Restrict)
  // An option with bookings can't be deleted (switch it off instead).
  optionId String     @map("option_id") @db.Uuid
  option   StayOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  // Denormalised from the stay so payouts and lists filter by event directly.
  eventId  String     @map("event_id") @db.Uuid
  event    Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("StayBooker", fields: [userId], references: [id], onDelete: Restrict)

  // The event registration that made the booker eligible.
  registrationId String?            @map("registration_id") @db.Uuid
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  status StayBookingStatus @default(PENDING)

  checkInDate  DateTime @map("check_in_date") @db.Date
  checkOutDate DateTime @map("check_out_date") @db.Date
  nights       Int
  // Number of guests = beds held.
  guestCount   Int      @map("guest_count")

  arrivalAt      DateTime? @map("arrival_at") @db.Timestamptz(6)
  emergencyName  String?   @map("emergency_name") @db.VarChar(120)
  emergencyPhone String?   @map("emergency_phone") @db.VarChar(20)
  note           String?   @db.Text
  // Answers to the stay's custom questions, keyed by StayQuestion id.
  answers        Json?

  // Money, snapshotted at request time. `totalAmount` is what the guest pays
  // = baseAmount + processingFee (the fee applies to ONLINE only).
  paymentMode    StayPaymentMode @map("payment_mode")
  baseAmount     Decimal         @default(0) @map("base_amount") @db.Decimal(10, 2)
  processingFee  Decimal         @default(0) @map("processing_fee") @db.Decimal(10, 2)
  totalAmount    Decimal         @default(0) @map("total_amount") @db.Decimal(10, 2)
  // Null for FREE. PENDING until paid (online, or marked paid at the property).
  paymentStatus  PaymentStatus?  @map("payment_status")
  paymentId      String?         @map("payment_id") @db.VarChar(255)
  orderId        String?         @map("order_id") @db.VarChar(255)
  paidAt         DateTime?       @map("paid_at") @db.Timestamptz(6)
  refundedAmount Decimal         @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  /// Platform fee % frozen on the sale when it was paid (A21), set by the
  /// stamp_platform_fee trigger. Payouts charge this, never today's rate.
  platformFeePercent Decimal? @map("platform_fee_percent") @db.Decimal(5, 2)
  /// Set while a captured payment that couldn't be honoured (sold out / closed
  /// while it was being paid) still has to go back in full. A retry job clears
  /// it on success; payouts never count such a row.
  refundDueAt    DateTime?       @map("refund_due_at") @db.Timestamptz(6)
  paymentDueAt   DateTime?       @map("payment_due_at") @db.Timestamptz(6)

  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason") @db.Text
  // Room / bed the team assigned, free text ("Block B, Room 204").
  allocation      String?   @db.VarChar(200)
  // Only the team sees this.
  staffNote       String?   @map("staff_note") @db.Text

  // The Stay Pass. Generated with the request, shown once CONFIRMED.
  passCode      String    @unique @map("pass_code") @db.VarChar(20)
  checkedInAt   DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedInById String?   @map("checked_in_by_id") @db.Uuid
  checkedOutAt  DateTime? @map("checked_out_at") @db.Timestamptz(6)

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?   @map("cancelled_by_id") @db.Uuid
  cancellationReason String?   @map("cancellation_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  guests StayGuest[]

  @@index([eventId, status])
  @@index([stayId])
  @@index([optionId, status])
  @@index([userId])
  @@index([registrationId])
  @@index([orderId])
  @@index([status, paymentDueAt])
  @@map("stay_bookings")
}

/// One person on a booking. The booker is the first guest.
model StayGuest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  bookingId String      @map("booking_id") @db.Uuid
  booking   StayBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name     String  @db.VarChar(120)
  phone    String? @db.VarChar(20)
  email    String? @db.VarChar(255)
  // MALE | FEMALE | OTHER
  gender   String  @db.VarChar(10)
  isBooker Boolean @default(false) @map("is_booker")
  // Photo ID: a FileAnswer ({ key, name, size, mime }) in private storage.
  idProof  Json?   @map("id_proof")
  order    Int     @default(0)

  @@index([bookingId])
  @@map("stay_guests")
}

/// A help topic teams raise queries under ("Food", "Wi-Fi"), with its points
/// of contact from the event team.
model HackathonHelpTopic {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  name       String   @db.VarChar(60)
  // Soft refs → users on the event team.
  pocUserIds String[] @default([]) @map("poc_user_ids") @db.Uuid
  order      Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  queries HackathonHelpQuery[]

  @@unique([leaderboardId, name])
  @@index([leaderboardId])
  @@map("hackathon_help_topics")
}

/// A query a team raised. Sent to the topic's POCs + the team's room
/// volunteers ("Other" → curators); `notifiedUserIds` is who it went to and
/// who sees it in their inbox.
model HackathonHelpQuery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  leaderboardId String      @map("leaderboard_id") @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  entrantId String             @map("entrant_id") @db.Uuid
  entrant   LeaderboardEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  // Null = "Other". The name is kept so the query still reads right if the topic goes.
  topicId   String?             @map("topic_id") @db.Uuid
  topic     HackathonHelpTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicName String              @map("topic_name") @db.VarChar(60)
  // Where the team was when it asked (soft ref + name).
  roomId    String?             @map("room_id") @db.Uuid
  roomName  String?             @map("room_name") @db.VarChar(120)

  message String                   @db.Text
  status  HackathonHelpQueryStatus @default(OPEN)

  raisedBy        String    @map("raised_by") @db.Uuid
  notifiedUserIds String[]  @default([]) @map("notified_user_ids") @db.Uuid
  // Who took it (soft ref), and when.
  handledBy       String?   @map("handled_by") @db.Uuid
  acknowledgedAt  DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  // D27: escalated to the organisers as a Space-desk Assist case (soft ref → support_tickets).
  escalatedAt     DateTime? @map("escalated_at") @db.Timestamptz(6)
  caseId          String?   @map("case_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([leaderboardId, status])
  @@index([entrantId, createdAt])
  @@index([notifiedUserIds], type: Gin)
  @@map("hackathon_help_queries")
}

// =====================================================
// PRODUCT MANAGEMENT (Apex /dashboard/product + Claude MCP)
// =====================================================

/// Same vocabulary as docs/version-5.md.
enum PmTaskStatus {
  NEXT
  PLANNED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW // PR open, waiting on a human to merge
  DONE
  PARKED
  DROPPED
}

/// A workstream, e.g. "S · Backend audit", "P · Marketing to 5.0.0".
model PmTrack {
  /// Short letter/number used in task keys ("S", "P", "0").
  key       String   @id @db.VarChar(16)
  name      String   @db.VarChar(160)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tasks PmTask[]

  @@map("pm_tracks")
}

/// One plan item. Never deleted: mark DROPPED with a reason in notes instead.
model PmTask {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human key from the plan, e.g. "S48", "P13". Unique across tracks.
  key       String       @unique @db.VarChar(32)
  trackKey  String       @map("track_key") @db.VarChar(16)
  title     String       @db.Text
  notes     String?      @db.Text
  status    PmTaskStatus @default(PLANNED)
  /// Free text: who is on it ("Abhinav", "Claude").
  owner     String?      @db.VarChar(80)
  dueDate   DateTime?    @map("due_date") @db.Date
  sortOrder Int          @default(0) @map("sort_order")
  /// Free-form tags, lowercased and de-duplicated ("mobile", "launch").
  labels    String[]     @default([])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  track    PmTrack      @relation(fields: [trackKey], references: [key], onUpdate: Cascade)
  activity PmActivity[]

  @@index([trackKey, sortOrder])
  @@index([status])
  @@index([labels], type: Gin)
  @@map("pm_tasks")
}

/// Append-only log: status changes and notes, from Apex or from Claude.
model PmActivity {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId  String? @map("task_id") @db.Uuid
  /// "Abhinav (apex)", "Claude (token: laptop)".
  actor   String  @db.VarChar(160)
  message String  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task PmTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([taskId, createdAt])
  @@map("pm_activity")
}

/// Personal access token for the /pm/mcp endpoint (Claude Code, claude.ai).
/// Only the SHA-256 hash is stored; the raw token is shown once on creation.
model PmApiToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(80)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// Platform admin who created it; the token acts as them and stops working
  /// if they lose ADMIN.
  userId     String    @map("user_id") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("pm_api_tokens")
}

enum AiRunOutcome {
  OK
  REFUSED
  ERROR
}

/// One Claude call made through AiService (D12): what it cost and how it
/// ended. Also the source of the per-user daily caps.
model AiRun {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// AiService feature key, e.g. "triage".
  feature          String       @db.VarChar(32)
  model            String       @db.VarChar(64)
  inputTokens      Int          @default(0) @map("input_tokens")
  outputTokens     Int          @default(0) @map("output_tokens")
  cacheReadTokens  Int          @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int          @default(0) @map("cache_write_tokens")
  costUsd          Decimal      @default(0) @map("cost_usd") @db.Decimal(10, 6)
  latencyMs        Int          @map("latency_ms")
  outcome          AiRunOutcome
  /// Who the call was made for (no FK: a log row outlives its user).
  userId           String?      @map("user_id") @db.Uuid
  /// What the call was about, e.g. "case:<id>".
  subject          String?      @db.VarChar(80)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, feature, createdAt])
  @@index([createdAt])
  @@map("ai_runs")
}

// ── Live engagement (Track L) ────────────────────────────────────────────────

enum PollStatus {
  DRAFT
  LIVE
  CLOSED

  @@map("poll_status")
}

/// Who sees a poll's counts. Organisers always do.
enum PollResultsVisibility {
  /// Attendees see results once they've voted (and everyone once it closes).
  AFTER_VOTE
  /// Attendees see results only once the poll closes.
  AFTER_CLOSE
  /// Never shown to attendees.
  ORGANISERS_ONLY

  @@map("poll_results_visibility")
}

/// L1: a live poll an organiser runs during an event. DRAFT -> LIVE -> CLOSED,
/// never back. Options are fixed once created (votes point at their index).
model Poll {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  question          String                @db.VarChar(300)
  options           String[]
  status            PollStatus            @default(DRAFT)
  resultsVisibility PollResultsVisibility @default(AFTER_VOTE) @map("results_visibility")

  launchedAt DateTime? @map("launched_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  votes PollVote[]

  @@index([eventId, status])
  @@map("polls")
}

/// One person's vote. The unique (poll, user) is what makes it one vote each.
model PollVote {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  pollId String @map("poll_id") @db.Uuid
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  optionIndex Int      @map("option_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pollId, userId])
  @@map("poll_votes")
}

enum QuizStatus {
  DRAFT
  LIVE
  ENDED

  @@map("quiz_status")
}

/// L3: a timed quiz an organiser runs during an event, one question at a time.
/// DRAFT -> LIVE -> ENDED. `currentIndex` is the open question's position
/// (null until started). The server stamps each question's window.
model Quiz {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title        String     @db.VarChar(200)
  status       QuizStatus @default(DRAFT)
  /// Correct answers earn up to 50% more the faster they come in.
  speedBonus   Boolean    @default(true) @map("speed_bonus")
  currentIndex Int?       @map("current_index")

  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  questions QuizQuestion[]
  answers   QuizAnswer[]

  @@index([eventId, status])
  @@map("quizzes")
}

/// One question. Answers open at `openedAt` and close at `closesAt`, both set
/// by the server; correct options never leave it before `closesAt`.
model QuizQuestion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  quizId String @map("quiz_id") @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  position       Int
  prompt         String   @db.VarChar(300)
  options        String[]
  correctIndexes Int[]    @map("correct_indexes")
  timeLimitSec   Int      @default(20) @map("time_limit_sec")
  points         Int      @default(100)

  openedAt DateTime? @map("opened_at") @db.Timestamptz(6)
  closesAt DateTime? @map("closes_at") @db.Timestamptz(6)

  answers QuizAnswer[]

  @@unique([quizId, position])
  @@map("quiz_questions")
}

/// One person's answer, scored by the server when it arrives. The unique
/// (question, user) is what makes it one answer each.
model QuizAnswer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  questionId String       @map("question_id") @db.Uuid
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  quizId String @map("quiz_id") @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  optionIndex Int      @map("option_index")
  correct     Boolean
  points      Int
  /// Server receipt time minus the question's openedAt.
  elapsedMs   Int      @map("elapsed_ms")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([questionId, userId])
  @@index([quizId])
  @@map("quiz_answers")
}

/// I2: one row per version of a legal document (Terms, Privacy, ...). A row
/// with publishedAt null is a draft; published rows are never edited, a change
/// is a new version. requiresAcceptance makes clients ask everyone (operators
/// only for the organiser agreement) to accept it on next launch.
model LegalDocument {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug    String  @db.VarChar(64)
  version Int
  title   String  @db.VarChar(160)
  /// Markdown.
  body    String  @db.Text
  /// What changed, shown on the accept sheet.
  summary String? @db.Text

  requiresAcceptance Boolean   @default(false) @map("requires_acceptance")
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  acceptances LegalAcceptance[]

  @@unique([slug, version])
  @@map("legal_documents")
}

/// I2: a user accepted one version of a legal document, from which client.
model LegalAcceptance {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String        @map("document_id") @db.Uuid
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  version    Int
  /// web, space, mobile.
  client     String   @db.VarChar(16)
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  @@unique([userId, documentId])
  @@map("legal_acceptances")
}

/// Unifesto Orbit: a student who represents Unifesto on one campus (a
/// top-level SUPER space). Rows are kept as history: ending a Lead sets
/// `endedAt`. At most one live row per (space, user), enforced by a partial
/// unique index in the migration.
model OrbitLead {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// Starts the 30-day probation and the inactivity clock.
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// A declared exam window: the inactivity clock is paused until then.
  examPauseUntil DateTime? @map("exam_pause_until") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  endReason      String?   @map("end_reason") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([spaceId])
  @@index([userId])
  @@map("orbit_leads")
}

/// Unifesto Orbit: a student's application to be a campus's Orbit Lead, from
/// unifesto.app/orbit/apply. Applicants are signed-in users, so appointing one
/// is a click. At most one PENDING row per user (partial unique index).
model OrbitApplication {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The campus they picked; null when their college isn't on Unifesto yet.
  spaceId String? @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  collegeName String @map("college_name") @db.VarChar(200)
  yearOfStudy String @map("year_of_study") @db.VarChar(60)
  myClubs     String @map("my_clubs") @db.Text
  campusClubs String @map("campus_clubs") @db.Text
  why         String @db.Text
  /// When they confirmed they are 18+ and agreed to the Privacy Policy.
  confirmedAt DateTime @map("confirmed_at") @db.Timestamptz(6)

  /// PENDING | APPOINTED | DECLINED
  status     String    @default("PENDING") @db.VarChar(20)
  reviewNote String?   @map("review_note") @db.VarChar(500)
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@index([userId])
  @@map("orbit_applications")
}
