  @@index([discussionId])
  @@index([authorId])
  @@index([createdAt])
  @@map("discussion_replies")
}

// =====================================================
// SUBSCRIPTION MODEL
// Organization subscription plans
// =====================================================

model OrgSubscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Spaces platform re-architecture: the billing subject is the Space. Every
  // subscription is keyed by `spaceId`. The P2.2 contract migration dropped the
  // legacy per-user `userId` column.
  spaceId String? @unique @map("space_id") @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // How this organiser is billed by the platform.
  billingModel        BillingModel @default(SUBSCRIPTION) @map("billing_model")
  // For REVENUE_SHARE: platform's cut of event sales, e.g. 8.00 (%).
  revenueSharePercent Decimal?     @map("revenue_share_percent") @db.Decimal(5, 2)

  plan         OrgPlan      @default(STARTER)
  billingCycle BillingCycle @default(MONTHLY) @map("billing_cycle")
  amount       Decimal      @default(0) @db.Decimal(10, 2)
  currency     String       @default("INR") @db.VarChar(3)
  isActive     Boolean      @default(true) @map("is_active")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  razorpaySubId String?   @map("razorpay_sub_id") @db.VarChar(255)
  lastPaymentAt DateTime? @map("last_payment_at") @db.Timestamptz(6)
  nextPaymentAt DateTime? @map("next_payment_at") @db.Timestamptz(6)

  eventsThisMonth Int      @default(0) @map("events_this_month")
  usageResetAt    DateTime @default(now()) @map("usage_reset_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  history SubscriptionHistory[]

  @@map("org_subscriptions")
}

model SubscriptionHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  subscriptionId String          @map("subscription_id") @db.Uuid
  subscription   OrgSubscription @relation(fields: [subscriptionId], references: [id])

  fromPlan  OrgPlan  @map("from_plan")
  toPlan    OrgPlan  @map("to_plan")
  reason    String?  @db.VarChar(500)
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@map("subscription_history")
}

// Admin-editable definition of what each subscription plan includes.
// One row per OrgPlan. Null numeric = unlimited. Drives both display and
// enforcement (via the cached PlanConfigService).
model PlanConfig {
  plan OrgPlan @id

  // Limits (null = unlimited)
  spaces            Int?
  eventsPerMonth    Int? @map("events_per_month")
  attendeesPerEvent Int? @map("attendees_per_event")
  ticketTypes       Int? @map("ticket_types")
  coCurators        Int? @map("co_organisers")

  // Feature flags
  hasWaitlist        Boolean @default(false) @map("has_waitlist")
  hasBulkExport      Boolean @default(false) @map("has_bulk_export")
  hasAnalytics       Boolean @default(false) @map("has_analytics")
  hasWhatsappBlast   Boolean @default(false) @map("has_whatsapp_blast")
  hasRecurringEvents Boolean @default(false) @map("has_recurring_events")
  hasRemoveBranding  Boolean @default(false) @map("has_remove_branding")
  hasPrioritySupport Boolean @default(false) @map("has_priority_support")
  // Gates the whole Sessions feature: creating, listing and hosting them.
  hasSessions        Boolean @default(false) @map("has_sessions")
  // Gates the competitive dashboard (hack.unifesto.app): whether an event may
  // have a leaderboard at all. Per-event on/off lives on Leaderboard.enabled.
  hasLeaderboard     Boolean @default(false) @map("has_leaderboard")
  // Gates the certificate system: designing templates and issuing certificates.
  // Public verification stays open to everyone regardless of plan.
  hasCertificates    Boolean @default(false) @map("has_certificates")
  // Gates the sponsors & lead-generation feature: the space sponsor roster,
  // attaching sponsors to events, lead capture and the sponsor portal.
  hasSponsors        Boolean @default(false) @map("has_sponsors")

  // Fees & pricing
  processingFeePercent Decimal @default(0) @map("processing_fee_percent") @db.Decimal(5, 2)
  monthlyPrice         Int?    @map("monthly_price") // null = custom / contact sales
  annualPrice          Int?    @map("annual_price")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("plan_configs")
}

// Admin-editable definition of the non-subscription billing models
// (FREE and REVENUE_SHARE). Same limit/feature set as a plan, plus a default
// platform cut for revenue-share. Drives what those organisers can do.
model BillingModelConfig {
  billingModel BillingModel @id @map("billing_model")

  // For REVENUE_SHARE: the % prefilled when assigning this model.
  defaultRevenueSharePercent Decimal? @map("default_revenue_share_percent") @db.Decimal(5, 2)

  // Limits (null = unlimited)
  spaces            Int?
  eventsPerMonth    Int? @map("events_per_month")
  attendeesPerEvent Int? @map("attendees_per_event")
  ticketTypes       Int? @map("ticket_types")
  coCurators        Int? @map("co_organisers")

  // Feature flags
  hasWaitlist        Boolean @default(false) @map("has_waitlist")
  hasBulkExport      Boolean @default(false) @map("has_bulk_export")
  hasAnalytics       Boolean @default(false) @map("has_analytics")
  hasWhatsappBlast   Boolean @default(false) @map("has_whatsapp_blast")
  hasRecurringEvents Boolean @default(false) @map("has_recurring_events")
  hasRemoveBranding  Boolean @default(false) @map("has_remove_branding")
  hasPrioritySupport Boolean @default(false) @map("has_priority_support")
  // Gates the whole Sessions feature: creating, listing and hosting them.
  hasSessions        Boolean @default(false) @map("has_sessions")
  // Gates the competitive dashboard (hack.unifesto.app): whether an event may
  // have a leaderboard at all. Per-event on/off lives on Leaderboard.enabled.
  hasLeaderboard     Boolean @default(false) @map("has_leaderboard")
  // Gates the certificate system: designing templates and issuing certificates.
  hasCertificates    Boolean @default(false) @map("has_certificates")
  // Gates the sponsors & lead-generation feature (see PlanConfig.hasSponsors).
  hasSponsors        Boolean @default(false) @map("has_sponsors")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_model_configs")
}

// =====================================================
// EVENT MODELS
// Event management system
// =====================================================

model Event {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title         String  @db.VarChar(500)
  slug          String  @unique @db.VarChar(200)
  description   String? @db.Text
  coverImageUrl String? @map("cover_image_url") @db.Text

  type             EventType        @default(IN_PERSON)
  registrationType RegistrationType @default(RSVP) @map("registration_type")

  startDateTime DateTime @map("start_date_time") @db.Timestamptz(6)
  endDateTime   DateTime @map("end_date_time") @db.Timestamptz(6)
  timezone      String   @default("Asia/Kolkata") @db.VarChar(100)

  // Venue (IN_PERSON or HYBRID)
  venueName    String? @map("venue_name") @db.VarChar(255)
  venueAddress String? @map("venue_address") @db.Text
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  country      String? @default("India") @db.VarChar(100)
  latitude     Float?
  longitude    Float?

  // Online (ONLINE or HYBRID)
  onlineUrl      String? @map("online_url") @db.Text
  onlinePlatform String? @map("online_platform") @db.VarChar(100)

  // Registration
  capacity        Int?
  registeredCount Int     @default(0) @map("registered_count")
  waitlistEnabled Boolean @default(false) @map("waitlist_enabled")
  waitlistCount   Int     @default(0) @map("waitlist_count")
  isFree          Boolean @default(true) @map("is_free")

  // Metadata
  tags       String[]
  category   String?         @db.VarChar(100)
  visibility EventVisibility @default(PUBLIC)
  status     EventStatus     @default(DRAFT)

  // White-label branding (attendee-facing only). Rendered on the public event
  // page ONLY when `whiteLabelEnabled` (admin-approved via WhiteLabelRequest)
  // AND the space's plan still includes `hasRemoveBranding`. `brandLogoUrl`
  // falls back to the space's logo when null.
  whiteLabelEnabled Boolean @default(false) @map("white_label_enabled")
  brandColor        String? @map("brand_color") @db.VarChar(9)
  brandLogoUrl      String? @map("brand_logo_url") @db.Text

  // Manual attendee add: comping a PAID ticket (adding for free, i.e. NOT sending
  // a payment link) is blocked by default so the platform's processing fee is
  // never silently waived. A Platform Admin flips this on per-event by approving
  // a FreeAttendeeAddRequest; only then can an organiser uncheck "collect payment".
  allowFreeAttendeeAdd Boolean @default(false) @map("allow_free_attendee_add")

  // Recurring (event-calendar P2). Model A: an occurrence IS an Event row,
  // materialized from an RRULE held on a *series-parent* Event.
  //   - isRecurring = true marks a series-PARENT: a non-registerable template
  //     that is hidden from every attendee/space listing. Its `recurringRule`
  //     holds the RFC-5545 RRULE (e.g. "FREQ=WEEKLY;BYDAY=SA;COUNT=10").
  //   - An OCCURRENCE has isRecurring = false and `seriesParentId` pointing at
  //     its parent; it is a normal event with its own tickets/capacity/check-in.
  isRecurring   Boolean @default(false) @map("is_recurring")
  recurringRule String? @map("recurring_rule") @db.Text

  // Series ↔ occurrence relation, kept deliberately separate from the
  // parentEvent/EventHierarchy (festival sub-events) relation — an event may
  // not be both a recurring series and a festival sub-event in v1. SetNull so
  // deleting the parent template leaves its occurrences standing as ordinary
  // events rather than cascading them away.
  seriesParentId       String?   @map("series_parent_id") @db.Uuid
  seriesParent         Event?    @relation("EventSeries", fields: [seriesParentId], references: [id], onDelete: SetNull)
  seriesOccurrences    Event[]   @relation("EventSeries")
  // An occurrence that was edited individually ("this occurrence" edit scope):
  // whole-series regeneration must never overwrite it. Occurrences with any
  // registration are frozen regardless of this flag (D4).
  seriesDetached       Boolean   @default(false) @map("series_detached")
  // Rolling-window high-water mark on the PARENT: the far edge of the range we
  // have already materialized. The daily reconcile cron extends it forward.
  seriesGeneratedUntil DateTime? @map("series_generated_until") @db.Timestamptz(6)

  // Parent / sub-event hierarchy. A "big event" (parent) groups several
  // sub-events under one umbrella — a festival with its hackathon, workshops
  // and keynote. Registration stays per-event: the parent is a hub page that
  // lists its sub-events, each keeping its own tickets, capacity and check-in.
  //
  // One level deep by design: a sub-event may not itself be a parent, and both
  // ends must belong to the same space. `onDelete: SetNull` (not Cascade) so a
  // sub-event outlives its parent — hard-deleting a parent leaves its children
  // standing as ordinary events rather than dragging them down with it.
  parentEventId String? @map("parent_event_id") @db.Uuid
  parentEvent   Event?  @relation("EventHierarchy", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents   Event[] @relation("EventHierarchy")

  // WhatsApp group / community. Organiser-supplied invite links (there is no
  // WhatsApp API to auto-create these — the organiser makes the group/community
  // by hand and pastes the `chat.whatsapp.com/<code>` link). We surface a
  // "Join WhatsApp Group" button and push the link to attendees on registration.
  //
  // Mirrors the parent/child model: a big/parent event carries a *community*
  // link (the umbrella), a sub-event or standalone event carries a *group* link.
  // Both validated + canonicalised via common/whatsapp-links.ts before storage.
  //
  // LEGACY (retired 2026-09-20): `whatsappGroupUrl`/`whatsappCommunityUrl` used
  // to double as BOTH the public "Join" button and the attendee invite source,
  // which leaked the invite link on the public event payload (older mobile
  // builds still read it). They are no longer surfaced publicly nor used for
  // invites — kept only so historical data isn't destroyed. Do not read them.
  whatsappGroupUrl     String? @map("whatsapp_group_url") @db.Text
  whatsappCommunityUrl String? @map("whatsapp_community_url") @db.Text

  // Private attendee invite group. Unlike the legacy fields above, this is NEVER
  // returned on an unauthenticated path (stripped from `getEventBySlug`); it is
  // surfaced only through JWT-guarded per-registration endpoints and pushed to
  // attendees on registration/blast. A sub-event with no group of its own falls
  // back to its parent big event's attendee group. Validated + canonicalised via
  // common/whatsapp-links.ts (always a 'group').
  whatsappAttendeeGroupUrl String? @map("whatsapp_attendee_group_url") @db.Text

  // Attendee controls (curator / space admin, Event settings in the app).
  // Team leads may replace a claimed member of their group while this is on;
  // curators can always replace from Manage › Attendees.
  allowTeamChanges     Boolean   @default(false) @map("allow_team_changes")
  // Attendees may edit their own registration answers (solo: theirs; group:
  // the lead the team's, each member their own) while this is on and before
  // `attendeeEditsUntil` (null = no deadline). Curators can always edit.
  attendeeEditsEnabled Boolean   @default(false) @map("attendee_edits_enabled")
  attendeeEditsUntil   DateTime? @map("attendee_edits_until") @db.Timestamptz(6)

  // Space
  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Creator
  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("EventCreator", fields: [createdBy], references: [id])

  // Default payout destination for this event. When set, payouts for the event
  // go here instead of the creator's primary account — this is how an organiser
  // routes a particular event's earnings to a co-organiser's account. Nullable:
  // unset falls back to the creator's verified primary. SetNull if the account
  // is deleted. Eligibility (creator or a space co/organiser) is enforced in
  // the service, not the DB.
  payoutBankAccountId String?            @map("payout_bank_account_id") @db.Uuid
  payoutBankAccount   PayoutBankAccount? @relation("EventPayoutAccount", fields: [payoutBankAccountId], references: [id], onDelete: SetNull)

  // Status timestamps
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.Text

  // Soft delete. A non-null `deletedAt` hides the event everywhere an
  // organiser or attendee could see it, without destroying anything: the
  // registrations, tickets, payments and payouts hanging off it all survive
  // and come back intact if it is restored.
  //
  // Distinct from CANCELLED, which is a public statement to attendees that the
  // event is off. Hiding is private housekeeping and says nothing to anyone —
  // which is why an event must be cancelled *before* it can be hidden.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Set when the daily job deleted this event's registration-question file
  // uploads (180 days after it ended). Null = files may still exist.
  formUploadsPurgedAt DateTime? @map("form_uploads_purged_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ticketTypes                    EventTicketType[]
  registrations                  EventRegistration[]
  agenda                         EventAgenda[]
  speakers                       EventSpeaker[]
  prizes                         EventPrize[]
  contacts                       EventContact[]
  faqs                           EventFaq[]
  formFields                     EventFormField[]
  payouts                        Payout[]
  refundRequests                 RefundRequest[]
  userRoles                      UserRole[]
  checkinAccess                  EventCheckinAccess[]
  checkinTypes                   EventCheckinType[]
  coHosts                        EventCoHost[]
  ownershipTransfers             EventOwnershipTransfer[]
  subEventAttachRequestsAsParent SubEventAttachRequest[]  @relation("SubEventAttachParent")
  subEventAttachRequestsAsChild  SubEventAttachRequest[]  @relation("SubEventAttachChild")
  favoritedBy                    FavoriteEvent[]
  leaderboard                    Leaderboard?
  whiteLabelRequests             WhiteLabelRequest[]
  freeAttendeeAddRequests        FreeAttendeeAddRequest[]
  certificateTemplates           CertificateTemplate[]
  certificates                   Certificate[]
  reports                        EventReport[]
  eventSponsors                  EventSponsor[]
  leads                          Lead[]
  coupons                        EventCoupon[]
  partnerLinks                   EventPartnerLink[]
  pageViews                      PageView[]
  shortLinks                     ShortLink[]

  @@index([spaceId])
  @@index([status])
  @@index([startDateTime])
  @@index([slug])
  @@index([createdBy])
  // Every listing filters `deletedAt: null`, so it belongs in the hot indexes.
  @@index([deletedAt])
  // Sub-event lookups (hub pages, management lists) filter by parent.
  @@index([parentEventId])
  // Series reconciliation lists occurrences by their parent.
  @@index([seriesParentId])
  @@index([payoutBankAccountId])
  @@map("events")
}

/// A user's saved / favourited event. One row per (user, event).
model FavoriteEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("favorite_events")
}

model EventTicketType {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String  @db.VarChar(255)
  description   String? @db.Text
  price         Decimal @db.Decimal(10, 2)
  currency      String  @default("INR") @db.VarChar(3)
  // null = unlimited capacity. RSVP + individual tickets are typically null.
  totalQuantity Int?    @map("total_quantity")
  soldCount     Int     @default(0) @map("sold_count")

  // Registration mechanism:
  //   RSVP       → one-click, free, no form.
  //   INDIVIDUAL → free/paid, one per person, optional custom form.
  //   GROUP      → free/paid, priced per-group or per-person, min/max group size.
  kind             TicketKind        @default(INDIVIDUAL)
  groupPricingMode GroupPricingMode? @map("group_pricing_mode")
  minGroupSize     Int?              @map("min_group_size")
  maxGroupSize     Int?              @map("max_group_size")

  saleStartsAt DateTime? @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt   DateTime? @map("sale_ends_at") @db.Timestamptz(6)
  perUserLimit Int       @default(1) @map("per_user_limit")

  // Waiting list. Only meaningful when totalQuantity is set — an unlimited
  // ticket never sells out, so it can never queue anyone. When this ticket is
  // full, registration attempts join the queue instead of failing.
  // Offering a spot holds the seat for waitlistOfferTtlHours; if the attendee
  // has not paid by then the offer expires and the seat returns to the pool.
  waitlistEnabled       Boolean @default(false) @map("waitlist_enabled")
  waitlistOfferTtlHours Int     @default(24) @map("waitlist_offer_ttl_hours")

  isVisible Boolean @default(true) @map("is_visible")
  isActive  Boolean @default(true) @map("is_active")
  order     Int     @default(0)

  // Per-ticket-type WhatsApp group invite link, so an organiser can run
  // separate groups per tier (e.g. VIP vs General, speakers vs attendees).
  // When set it takes precedence over the event's own group link for anyone on
  // this ticket; when null the attendee falls back to the event group, then the
  // (event/parent) community. Validated + canonicalised via common/whatsapp-links.ts.
  whatsappGroupUrl String? @map("whatsapp_group_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  registrations EventRegistration[]
  formFields    EventFormField[]

  // Directional registration restrictions (organiser-configured). Holding a
  // ticket that lists T among its `blocks` makes T unavailable to that user.
  // `blocks` = rows where this ticket is the blocker; `blockedBy` = rows where
  // this ticket is the one made unavailable. The reverse direction is
  // independent: owning the blocked ticket does not prevent buying the blocker.
  blocks    TicketTypeBlock[] @relation("TicketBlocker")
  blockedBy TicketTypeBlock[] @relation("TicketBlocked")

  @@index([eventId])
  @@map("event_ticket_types")
}

/// A directional exclusion between two ticket types of the same event:
/// a user who holds `blocker` cannot register for `blocked`.
model TicketTypeBlock {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  blockerId String          @map("blocker_id") @db.Uuid
  blocker   EventTicketType @relation("TicketBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String          @map("blocked_id") @db.Uuid
  blocked   EventTicketType @relation("TicketBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("ticket_type_blocks")
}

/// A discount code an organiser issues against one event. The discount reduces
/// the base ticket amount only; the processing fee is recomputed on the reduced
/// base, so a coupon never touches gateway economics, only what the organiser
/// collects.
///
/// Usage cap is enforced as a HARD reservation: `usedCount` is atomically
/// incremented when a buyer applies the code at checkout (holding a slot) and
/// decremented if that attempt is abandoned, fails, or its reservation lapses.
/// So `usedCount` == confirmed redemptions + slots currently held mid-checkout,
/// and `usageLimit` is never exceeded even under concurrent checkouts.
model EventCoupon {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Stored uppercased; unique per event (see @@unique below). Buyers type it at
  // checkout case-insensitively.
  code String @db.VarChar(64)

  description String? @db.Text

  discountType      CouponDiscountType @map("discount_type")
  // PERCENT: 0-100. FLAT: an amount in the ticket currency.
  discountValue     Decimal            @map("discount_value") @db.Decimal(10, 2)
  // Percentage coupons only: cap the money taken off. null = uncapped.
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(10, 2)
  // Minimum base ticket amount required for the code to apply. null = no floor.
  minPurchaseAmount Decimal?           @map("min_purchase_amount") @db.Decimal(10, 2)

  // Total redemptions allowed across all users. null = unlimited (no hard cap;
  // reservation still tracks usedCount for reporting but never blocks).
  usageLimit   Int? @map("usage_limit")
  // Redemptions a single user may make. Enforced against their confirmed +
  // reserved redemptions of this coupon.
  perUserLimit Int  @default(1) @map("per_user_limit")
  // Confirmed redemptions + slots held mid-checkout. Source of truth for the cap.
  usedCount    Int  @default(0) @map("used_count")

  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  // Restrict the code to specific ticket types. Empty = applies to every ticket
  // type of the event.
  appliesToTicketTypeIds String[] @map("applies_to_ticket_type_ids") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions CouponRedemption[]

  @@unique([eventId, code])
  @@index([eventId])
  @@map("event_coupons")
}

/// One application of a coupon to one registration. Holds the reservation
/// lifecycle the coupon's `usedCount` counter cannot express on its own, and is
/// the row the TTL sweep scans to release stale RESERVED slots.
model CouponRedemption {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  couponId String      @map("coupon_id") @db.Uuid
  coupon   EventCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  registrationId String            @unique @map("registration_id") @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Money actually taken off the base amount by this redemption.
  discountAmount Decimal @map("discount_amount") @db.Decimal(10, 2)

  status        CouponRedemptionStatus @default(RESERVED)
  // While RESERVED, the deadline past which the sweep releases the held slot.
  // Cleared to null on CONFIRMED.
  reservedUntil DateTime?              @map("reserved_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([couponId])
  @@index([userId])
  // The TTL sweep scans RESERVED rows past their deadline.
  @@index([status, reservedUntil])
  @@map("coupon_redemptions")
}

model EventAgenda {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

