# Local development env (J14). Copy to backend/.env (and backend/.env.local,
# which wins over .env), then:
#   docker compose -f docker-compose.dev.yml up -d
#   cd backend && npx prisma migrate deploy && npm run start:dev
# Every value here is a dummy or localhost. Never put prod secrets on a laptop:
# the backend and prisma refuse an *.rds.amazonaws.com DATABASE_URL/DIRECT_URL
# unless NODE_ENV=production.

NODE_ENV=development
PORT=8080

# docker-compose.dev.yml Postgres (no TLS, so sslmode=disable: allowed only outside production)
DATABASE_URL=postgresql://unifesto:unifesto@localhost:5432/unifesto?sslmode=disable
DIRECT_URL=postgresql://unifesto:unifesto@localhost:5432/unifesto?sslmode=disable

# docker-compose.dev.yml Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# Required at boot by ConfigValidationService. Dummies: S3 uploads, Cognito
# (mobile Google login) and Razorpay checkout won't work until you add
# test-mode credentials of your own (never the live ones).
AWS_REGION=ap-south-1
S3_BUCKET_NAME=unifesto-dev-dummy
COGNITO_USER_POOL_ID=ap-south-1_devdummy
COGNITO_CLIENT_ID=dev-dummy-client-id
JWT_SECRET=dev-only-jwt-secret-change-me
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dev-dummy-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=dev-dummy-webhook-secret

# Optional: SSR internal key (same value in websites/web/.env.local if you run web locally)
INTERNAL_API_KEY=dev-internal-api-key
